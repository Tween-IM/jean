<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title).gsub("TMCP Admin", "Tween Admin") : "Tween Admin" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-app">
    <% if current_admin_user %>
      <a href="#main" class="admin-skip">Skip to content</a>
      <div class="admin-shell" data-controller="admin-shell">
        <aside class="admin-sidebar" aria-label="Main navigation" id="admin-navigation">
          <%= link_to admin_dashboard_path, class: "admin-brand" do %>
            <span class="admin-brand-mark">t</span><span>tween<small>Workspace</small></span>
          <% end %>
          <button class="admin-button admin-mobile-menu" data-action="admin-shell#toggle">Close navigation</button>
          <nav>
            <% admin_navigation.each do |group, items| %>
              <% next if items.empty? %>
              <% if group.present? %>
                <details class="admin-nav-group" <%= 'open' if group == 'Workspace' || items.any? { |item| request.path == item[:path] || request.path.start_with?("#{item[:path]}/") } %>>
                  <summary class="admin-nav-section"><%= group %></summary>
                  <% items.each do |item| %><%= sidebar_link(item[:path], item[:label], item[:icon]) %><% end %>
                </details>
              <% else %>
                <% items.each do |item| %><%= sidebar_link(item[:path], item[:label], item[:icon]) %><% end %>
              <% end %>
            <% end %>
          </nav>
          <div class="admin-sidebar-footer">
            <p>One workspace. All of Tween.</p>
            <%= button_to "Sign out", admin_logout_path, method: :delete, class: "admin-button", style: "margin-top:12px;width:100%" %>
          </div>
        </aside>
        <div class="admin-main">
          <header class="admin-topbar">
            <button class="admin-button admin-mobile-menu" aria-controls="admin-navigation" aria-expanded="false" data-admin-shell-target="toggle" data-action="admin-shell#toggle">Menu</button>
            <%= form_with url: admin_users_path, method: :get, role: "search" do %>
              <%= fluent_icon "search" %>
              <label for="workspace-search" class="sr-only">Find a person by Matrix ID</label>
              <input id="workspace-search" type="search" name="query" placeholder="Find a person by name or Matrix ID…" value="<%= params[:query] if controller_name == 'users' %>">
            <% end %>
            <div class="admin-topbar-account">
              <span class="admin-account-label"><%= current_admin_user.matrix_username %><small><%= current_admin_user.platform_role.humanize %></small></span>
              <span class="admin-avatar" aria-hidden="true"><%= current_admin_user.matrix_username.to_s.first(2).upcase %></span>
            </div>
          </header>
          <main id="main" class="admin-content" tabindex="-1">
            <% flash.each do |kind, message| %>
              <div role="status" class="admin-flash <%= 'admin-flash-alert' if kind == 'alert' %>"><%= message %></div>
            <% end %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="admin-login">
        <div class="admin-login-panel">
          <div class="admin-brand"><span class="admin-brand-mark">t</span><span>tween<small>Staff workspace</small></span></div>
          <% flash.each do |kind, message| %>
            <div role="status" class="admin-flash admin-flash-alert"><%= message %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body></html>
