<% content_for :title, "Activity · Tween Admin" %>
<div class="admin-eyebrow">Administration</div>
<div class="admin-page-heading">
  <div>
    <h1>Activity log</h1>
    <p>A record of staff actions across the workspace.</p>
  </div>
</div>
<nav class="admin-tabs" aria-label="Activity streams"><%= link_to 'Workspace', admin_activity_path, class: 'admin-tab', aria: { current: @stream == 'workspace' ? 'page' : nil } %><%= link_to 'Financial operations', admin_activity_path(stream: 'payments'), class: 'admin-tab', aria: { current: @stream == 'payments' ? 'page' : nil } %></nav>
<%= form_with url: admin_activity_path, method: :get, class: 'admin-toolbar' do |f| %><%= f.hidden_field :stream, value: @stream %><%= f.search_field :query, value: params[:query], placeholder: 'Search actions or staff', class: 'admin-input', aria: { label: 'Search activity' } %><%= f.submit 'Search', class: 'admin-button' %><% end %>
<% if @error %><section class="admin-panel"><%= render 'admin/shared/unavailable', message: @error %></section>
<% elsif @stream == 'payments' %><section class="admin-panel"><%= render 'admin/shared/resource_table', records: @data.fetch('records'), fields: [], resource_key: 'payment_audit' %><div class="admin-pagination"><span><%= @data['total'] %> records</span><nav class="admin-actions" aria-label="Pagination"><% if @data['page'].to_i > 1 %><%= link_to 'Previous', admin_activity_path(stream: 'payments', page: @data['page'].to_i - 1, query: params[:query]), class: 'admin-button' %><% end %><% if @data['next_page'] %><%= link_to 'Next', admin_activity_path(stream: 'payments', page: @data['next_page'], query: params[:query]), class: 'admin-button' %><% end %></nav></div></section>
<% else %>
<section class="admin-panel">
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Staff member</th>
          <th>Action</th>
          <th>Target</th>
          <th>Outcome</th>
          <th>Reason</th>
          <th>Request</th>
        </tr>
      </thead>
      <tbody>
        <% @events.records.each do |event| %>
          <tr>
            <td><%= event.created_at.strftime('%d %b %Y, %H:%M %Z') %></td>
            <td><%= event.actor_matrix_id %></td>
            <td><%= event.action.humanize %></td>
            <td><%= event.target %></td>
            <td><%= admin_badge(event.outcome) %></td>
            <td><%= event.details['reason'].presence || '—' %></td>
            <td><%= event.request_id %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @events.records.empty? %>
    <div class="admin-empty">Staff actions will appear here.</div>
  <% end %>
  <%= render 'admin/shared/pagination', collection: @events %></section>

<% end %>
