<% content_for :title, "Overview · Tween Admin" %>
<div class="admin-eyebrow">Your workspace</div>
<div class="admin-page-heading">
  <div>
    <h1>Overview</h1>
    <p>The people, orders and operations that need your attention.</p>
  </div>
  <span class="admin-badge"><%= Date.current.strftime('%A, %d %B') %></span></div>
<div class="admin-grid">
  <div class="admin-metric">
    <div class="admin-metric-label">People on Tween</div>
    <div class="admin-metric-value"><%= number_with_delimiter(@stats[:total_users]) %></div>
    <div class="admin-metric-note"><%= @stats[:active_users] %> active accounts</div>
  </div>
  <% if current_admin_user.has_admin_permission?(:view_orders) %>
    <div class="admin-metric">
      <div class="admin-metric-label">Open orders</div>
      <div class="admin-metric-value"><%= number_with_delimiter(@commerce[:open_orders]) %></div>
      <div class="admin-metric-note">Across all stores</div>
    </div>
    <div class="admin-metric">
      <div class="admin-metric-label">Needs fulfilment</div>
      <div class="admin-metric-value"><%= number_with_delimiter(@commerce[:needs_fulfillment]) %></div>
      <div class="admin-metric-note">Ready for the next step</div>
    </div>
  <% end %>
  <% if current_admin_user.has_admin_permission?(:view_mini_apps) %>
    <div class="admin-metric">
      <div class="admin-metric-label">Active mini-apps</div>
      <div class="admin-metric-value"><%= number_with_delimiter(@stats[:active_mini_apps]) %></div>
      <div class="admin-metric-note"><%= @stats[:total_installations] %> installations</div>
    </div>
  <% end %>
</div>
<div class="admin-two-columns">
  <div>
    <% if current_admin_user.has_admin_permission?(:view_orders) %>
      <section class="admin-panel">
        <div class="admin-panel-heading">
          <div>
            <h2>Commerce operations</h2>
            <p>Orders that need a human, from payment to delivery.</p>
          </div>
          <%= link_to 'All orders →', admin_orders_path, class: 'admin-button' %></div>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Status</th>
                <th>Placed</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @attention_orders.each do |order| %>
                <tr>
                  <td><%= order.order_id %><small><%= order.buyer_user_id %></small></td>
                  <td><%= admin_badge(order.status) %></td>
                  <td><%= time_ago_in_words(order.created_at) %> ago</td>
                  <td><%= link_to 'Review →', admin_order_path(order) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @attention_orders.empty? %>
          <div class="admin-empty">You’re all caught up. No orders need attention.</div>
        <% end %></section>
    <% end %>
    <section class="admin-panel">
      <div class="admin-panel-heading">
        <div>
          <h2>Recently joined</h2>
          <p>Start with a person. See the whole picture.</p>
        </div>
        <%= link_to 'All people →', admin_users_path, class: 'admin-button' %></div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Person</th>
              <th>Account</th>
              <th>Joined</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @recent_users.each do |user| %>
              <tr>
                <td><%= user.matrix_username %><small><%= user.matrix_user_id %></small></td>
                <td><%= admin_badge(user.status) %></td>
                <td><%= user.created_at.strftime('%d %b %Y') %></td>
                <td><%= link_to 'Open →', admin_user_path(user) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @recent_users.empty? %>
        <div class="admin-empty">New people will appear here.</div>
      <% end %></section>
  </div>
  <div>
    <section class="admin-panel">
      <div class="admin-panel-heading">
        <h2>Your work queues</h2>
      </div>
      <% if current_admin_user.has_admin_permission?(:view_orders) %><%= link_to admin_orders_path, class: 'admin-queue-row' do %>
          <div>
            <p>Order operations</p>
            <small><%= commerce_attention_count %> orders need attention</small></div>
          <span>↗</span><% end %><% end %>
      <% if current_admin_user.has_admin_permission?(:view_mini_apps) %><%= link_to admin_mini_app_reviews_path, class: 'admin-queue-row' do %>
          <div>
            <p>App reviews</p>
            <small>Review submissions and appeals</small></div>
          <span>↗</span><% end %><% end %>
      <% %w[pending_transfers compliance_checks reports].each do |key| %><% item = Admin::Resources::CATALOG.fetch(key) %><% next unless current_admin_user.has_admin_permission?(item[:permission]) %><%= link_to admin_resource_path(key), class: 'admin-queue-row' do %>
          <div>
            <p><%= item[:label] %></p>
            <small>Open the queue</small></div>
          <span>↗</span><% end %><% end %>
    </section>
    <section class="admin-panel">
      <div class="admin-panel-body">
        <div class="admin-eyebrow">Connected operations</div>
        <h2 style="font-size:20px;letter-spacing:-.5px;margin:12px 0">One person.<br>
          The whole picture.</h2>
        <p style="color:var(--admin-muted);font-size:12px">Find a person to review their account, commerce, payments and messaging in one workspace.</p>
        <%= link_to 'Find a person →', admin_users_path, class: 'admin-button', style: 'margin-top:20px' %></div>
    </section>
  </div>
</div>
<% if current_admin_user.has_admin_permission?(:view_imports) %>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <div>
        <h2>Imported catalog</h2>
        <p>Keep the catalog complete and ready to sell.</p>
      </div>
      <%= link_to 'Review imports →', admin_imports_path, class: 'admin-button' %></div>
    <div class="admin-panel-body">
      <dl class="admin-detail-grid">
        <div>
          <dt>Imported products</dt>
          <dd><%= number_with_delimiter(@stats[:total_imported_products]) %></dd>
        </div>
        <div>
          <dt>Awaiting contact</dt>
          <dd><%= number_with_delimiter(@stats[:imported_stores_without_contact]) %> stores</dd>
        </div>
      </dl>
    </div>
  </section>
<% end %>
<% if current_admin_user.has_admin_permission?(:view_approvals) %>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <h2>Recent scope grants</h2>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Person</th>
            <th>Mini-app</th>
            <th>Scope</th>
            <th>Granted</th>
          </tr>
        </thead>
        <tbody><% @recent_approvals.each do |approval| %>
            <tr>
              <td><%= approval.user_id %></td>
              <td><%= approval.miniapp&.name || approval.miniapp_id %></td>
              <td><%= approval.scope %></td>
              <td><%= approval.approved_at&.strftime('%d %b %Y') %></td>
            </tr>
          <% end %></tbody>
      </table>
    </div>
    <% if @recent_approvals.empty? %>
      <div class="admin-empty">No scope grants yet.</div>
    <% end %></section>
<% end %>
