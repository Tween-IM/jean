<% content_for :title, "Dashboard — TMCP Admin" %>
<% content_for :page_title, "Dashboard" %>

<div class="max-w-7xl mx-auto px-6 py-8">
  <!-- Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Total Users</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:total_users]) %></p>
      <div class="mt-3 flex items-center gap-1.5">
        <span class="inline-flex items-center text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
          <%= fluent_icon "checkmark", class: "w-3 h-3 mr-0.5" %>
          <%= number_with_delimiter(@stats[:active_users]) %> active
        </span>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Mini Apps</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:total_mini_apps]) %></p>
      <div class="mt-3 flex items-center gap-1.5">
        <span class="inline-flex items-center text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
          <%= number_with_delimiter(@stats[:active_mini_apps]) %> active
        </span>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Installations</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:total_installations]) %></p>
      <div class="mt-3">
        <span class="text-xs text-gray-500">Across all mini-apps</span>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">OAuth Apps</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:total_oauth_apps]) %></p>
      <div class="mt-3">
        <span class="text-xs text-gray-500"><%= number_with_delimiter(@stats[:total_oauth_tokens]) %> active tokens</span>
      </div>
    </div>
  </div>

  <!-- Commerce operations -->
  <div class="bg-white rounded-xl border border-gray-200 mb-8">
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-gray-100">
      <div>
        <h2 class="text-sm font-semibold text-gray-900">Commerce operations</h2>
        <p class="text-xs text-gray-500 mt-0.5">Orders, stores and catalogue — including the platform-owned merchant</p>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-xs font-medium">
        <%= link_to "Orders", admin_orders_path, class: "text-indigo-600 hover:text-indigo-800" %>
        <%= link_to "Stores", admin_storefronts_path, class: "text-indigo-600 hover:text-indigo-800" %>
        <%= link_to "Listings", admin_products_path, class: "text-indigo-600 hover:text-indigo-800" %>
        <%= link_to "Merchants", admin_merchants_path, class: "text-indigo-600 hover:text-indigo-800" %>
        <%= link_to "Categories", admin_categories_path, class: "text-indigo-600 hover:text-indigo-800" %>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-6 divide-y lg:divide-y-0 lg:divide-x divide-gray-100">
      <div class="px-5 py-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Orders today</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@commerce[:orders_today]) %></p>
        <p class="mt-0.5 text-xs text-gray-500"><%= number_with_delimiter(@commerce[:orders_7d]) %> this week</p>
      </div>
      <div class="px-5 py-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Open</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@commerce[:open_orders]) %></p>
        <p class="mt-0.5 text-xs text-gray-500">not yet closed</p>
      </div>
      <div class="px-5 py-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Needs fulfilment</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight <%= @commerce[:needs_fulfillment].positive? ? 'text-amber-600' : 'text-gray-900' %>"><%= number_with_delimiter(@commerce[:needs_fulfillment]) %></p>
        <p class="mt-0.5 text-xs text-gray-500">paid, nothing shipped</p>
      </div>
      <div class="px-5 py-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">System merchant</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight <%= @commerce[:system_open_orders].positive? ? 'text-indigo-600' : 'text-gray-900' %>"><%= number_with_delimiter(@commerce[:system_open_orders]) %></p>
        <p class="mt-0.5 text-xs text-gray-500">open imported orders</p>
      </div>
      <div class="px-5 py-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Value · 30d</p>
        <p class="mt-1 text-xl font-semibold text-gray-900 tracking-tight"><%= money(@commerce[:gmv_30d_cents]) %></p>
        <p class="mt-0.5 text-xs text-gray-500"><%= money(@commerce[:refunds_30d_cents]) %> refunded</p>
      </div>
      <div class="px-5 py-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Branding gaps</p>
        <p class="mt-1 text-xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@commerce[:stores_without_logo]) %></p>
        <p class="mt-0.5 text-xs text-gray-500">mirrored stores with no logo</p>
      </div>
    </div>

    <div class="border-t border-gray-100">
      <div class="flex items-center justify-between px-5 py-3">
        <h3 class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Orders that need a human</h3>
        <%= link_to admin_orders_path(attention: 1), class: "text-xs font-medium text-indigo-600 hover:text-indigo-800" do %>
          Work the queue →
        <% end %>
      </div>
      <% if @attention_orders.any? %>
        <table class="min-w-full divide-y divide-gray-100">
          <tbody class="divide-y divide-gray-100">
            <% @attention_orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3 text-sm font-mono text-gray-900"><%= order.order_id %></td>
                <td class="px-5 py-3 text-sm text-gray-600 truncate max-w-[14rem]"><%= order.buyer_user_id %></td>
                <td class="px-5 py-3 text-sm text-gray-700">
                  <%= order.commerce_merchant.display_name %>
                  <% if order.commerce_merchant.system_owned? %><span class="text-xs text-indigo-600">· system</span><% end %>
                </td>
                <td class="px-5 py-3 text-sm text-gray-900"><%= money(order.total_cents, order.currency) %></td>
                <td class="px-5 py-3"><%= order_status_badge(order.status) %></td>
                <td class="px-5 py-3 text-xs text-gray-500"><%= time_ago_in_words(order.created_at) %> ago</td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "Manage", admin_order_path(order), class: "text-sm font-medium text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-5 py-6 text-sm text-gray-500">Nothing waiting — every paid order has moved.</div>
      <% end %>
    </div>
  </div>

  <!-- Imported catalog -->
  <div class="bg-white rounded-xl border border-gray-200 mb-8">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <div>
        <h2 class="text-sm font-semibold text-gray-900">Imported catalog</h2>
        <p class="text-xs text-gray-500 mt-0.5">Jumia and Konga catalogs mirrored by the scraper</p>
      </div>
      <%= link_to admin_imports_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1" do %>
        Monitor imports <%= fluent_icon "chevron_right", class: "w-3 h-3" %>
      <% end %>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4">
      <div class="px-5 py-4 border-b lg:border-b-0 border-gray-100 lg:border-r">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Source stores</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:total_imported_stores]) %></p>
      </div>
      <div class="px-5 py-4 border-b lg:border-b-0 border-gray-100 lg:border-r">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Imported listings</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:total_imported_products]) %></p>
      </div>
      <div class="px-5 py-4 border-b lg:border-b-0 border-gray-100 lg:border-r">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Awaiting contact</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight <%= @stats[:imported_stores_without_contact].positive? ? 'text-amber-600' : 'text-gray-900' %>"><%= number_with_delimiter(@stats[:imported_stores_without_contact]) %></p>
        <p class="mt-0.5 text-xs text-gray-500">Stores with no reachable seller</p>
      </div>
      <div class="px-5 py-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Last import sync</p>
        <p class="mt-1 text-sm font-medium text-gray-900">
          <%= @stats[:last_import_sync_at] ? "#{time_ago_in_words(@stats[:last_import_sync_at])} ago" : "never" %>
        </p>
      </div>
    </div>
  </div>

  <!-- Two Column: Recent Users + Recent Mini Apps -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Recent Users -->
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Recent Users</h2>
          <p class="text-xs text-gray-500 mt-0.5">Latest sign-ups on the platform</p>
        </div>
        <%= link_to admin_users_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1" do %>
          View all <%= fluent_icon "chevron_right", class: "w-3 h-3" %>
        <% end %>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-gray-50 text-xs font-medium text-gray-500 uppercase">
            <tr>
              <th class="px-5 py-3">User</th>
              <th class="px-5 py-3">Matrix ID</th>
              <th class="px-5 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @recent_users.each do |user| %>
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="px-5 py-3 text-gray-900 font-medium"><%= user.matrix_username || user.matrix_user_id %></td>
                <td class="px-5 py-3 font-mono text-xs text-gray-600"><%= user.matrix_user_id %></td>
                <td class="px-5 py-3">
                  <% color = case user.status
                    when 'active' then 'bg-emerald-50 text-emerald-700'
                    when 'suspended' then 'bg-amber-50 text-amber-700'
                    when 'deactivated' then 'bg-gray-50 text-gray-700'
                    else 'bg-gray-50 text-gray-700'
                    end %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= color %>">
                    <%= user.status %>
                  </span>
                </td>
              </tr>
            <% end %>
            <% if @recent_users.empty? %>
              <tr>
                <td colspan="3" class="px-5 py-8 text-center text-sm text-gray-400">No users yet</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent Mini Apps -->
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Recent Mini Apps</h2>
          <p class="text-xs text-gray-500 mt-0.5">Latest app registrations</p>
        </div>
        <%= link_to admin_mini_apps_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1" do %>
          View all <%= fluent_icon "chevron_right", class: "w-3 h-3" %>
        <% end %>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-gray-50 text-xs font-medium text-gray-500 uppercase">
            <tr>
              <th class="px-5 py-3">Name</th>
              <th class="px-5 py-3">App ID</th>
              <th class="px-5 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @recent_mini_apps.each do |app| %>
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="px-5 py-3 text-gray-900 font-medium"><%= app.name %></td>
                <td class="px-5 py-3 font-mono text-xs text-gray-600"><%= app.app_id %></td>
                <td class="px-5 py-3">
                  <% color = case app.status
                    when 'active' then 'bg-emerald-50 text-emerald-700'
                    when 'pending' then 'bg-amber-50 text-amber-700'
                    when 'rejected' then 'bg-red-50 text-red-700'
                    else 'bg-gray-50 text-gray-700'
                    end %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= color %>">
                    <%= app.status %>
                  </span>
                </td>
              </tr>
            <% end %>
            <% if @recent_mini_apps.empty? %>
              <tr>
                <td colspan="3" class="px-5 py-8 text-center text-sm text-gray-400">No mini apps yet</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Pending Approvals -->
  <div class="bg-white rounded-xl border border-gray-200">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <div>
        <h2 class="text-sm font-semibold text-gray-900">Pending Approvals</h2>
        <p class="text-xs text-gray-500 mt-0.5">OAuth scope approvals awaiting admin review</p>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-50 text-xs font-medium text-gray-500 uppercase">
          <tr>
            <th class="px-5 py-3">User</th>
            <th class="px-5 py-3">Mini App</th>
            <th class="px-5 py-3">Scope</th>
            <th class="px-5 py-3">Requested</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @pending_approvals.each do |approval| %>
            <tr class="hover:bg-gray-50/50 transition-colors">
              <td class="px-5 py-3 text-gray-700"><%= approval.user&.matrix_user_id %></td>
              <td class="px-5 py-3 text-gray-700"><%= approval.miniapp&.name || approval.miniapp_id %></td>
              <td class="px-5 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-indigo-50 text-indigo-700">
                  <%= approval.scope %>
                </span>
              </td>
              <td class="px-5 py-3 text-xs text-gray-500 whitespace-nowrap"><%= time_ago_in_words(approval.created_at) %> ago</td>
            </tr>
          <% end %>
          <% if @pending_approvals.empty? %>
            <tr>
              <td colspan="4" class="px-5 py-8 text-center text-sm text-gray-400">No pending approvals</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
