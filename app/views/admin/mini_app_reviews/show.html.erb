<div class="admin-eyebrow"><%= link_to 'Mini-app review queue', admin_mini_app_reviews_path %> / Review</div>
<div class="admin-page-heading"><div><h1><%= @mini_app.name %></h1><p><%= @mini_app.app_id %> · <%= @mini_app.version %><% if @mini_app.developer_user_id.present? %> · Submitted by <%= @mini_app.developer_user_id %><% end %></p></div><%= admin_badge(@mini_app.status) %></div>
<%= render 'admin/mini_apps/configuration' %>
<% if current_admin_user.has_admin_permission?(:manage_mini_apps) && %w[pending_review under_review appeal_submitted].include?(@mini_app.status) %>
<% { 'Approve configuration' => admin_approve_mini_app_review_path(@mini_app), 'Request changes' => admin_request_changes_mini_app_review_path(@mini_app), 'Reject submission' => admin_reject_mini_app_review_path(@mini_app) }.each do |label, destination| %>
<details class="admin-panel admin-action-panel"><summary class="admin-panel-heading"><%= label %></summary><%= form_with url: destination, class: 'admin-panel-body admin-command', data: { turbo_confirm: "#{label} for #{@mini_app.name}? Your decision will be recorded." } do |f| %><%= f.label :reason, 'Decision reason' %><%= f.text_area :reason, required: true, minlength: 5, maxlength: 1000, class: 'admin-input' %><%= f.submit label, class: 'admin-button admin-button-primary' %><% end %></details>
<% end %><% end %>
<p class="admin-muted">Approval grants this reviewed configuration. Activation is a separate action on the app page.</p>
<%= link_to 'Open app management', admin_mini_app_path(@mini_app), class: 'admin-button' %>

<% if @appeals.any? %><section class="admin-panel"><div class="admin-panel-heading"><h2>Appeals</h2></div><div class="admin-panel-body"><% @appeals.each do |appeal| %><article class="admin-evidence-item"><p><%= appeal.reason %></p><p><%= admin_badge(appeal.status) %> · <%= admin_short_date(appeal.created_at) %></p><% if appeal.status == 'pending_review' && current_admin_user.has_admin_permission?(:manage_mini_apps) %><%= form_with url: admin_resolve_mini_app_appeal_path, class: 'admin-command', data: { turbo_confirm: 'Record this appeal decision?' } do |f| %><%= f.hidden_field :appeal_id, value: appeal.id %><%= admin_select :approve, label: 'Decision', choices: [['Keep rejected', 'false'], ['Approve appeal', 'true']], selected: 'false' %><%= f.label :reason, 'Reason' %><%= f.text_area :reason, required: true, minlength: 5, maxlength: 1000, class: 'admin-input' %><%= f.submit 'Record decision', class: 'admin-button' %><% end %><% end %></article><% end %></div></section><% end %>
