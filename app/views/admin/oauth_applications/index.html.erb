<div class="mb-8">
  <h1 class="admin-title text-3xl font-bold text-slate-900">OAuth Applications</h1>
  <p class="text-slate-500 mt-1">Manage registered OAuth applications</p>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden admin-panel">
  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Client ID</th>
        <th scope="col">Confidential</th>
        <th scope="col">Scopes</th>
        <th scope="col">Created</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @applications.records.each do |app| %>
        <tr class="hover:bg-slate-50">
          <td><%= app.name %></td>
          <td><%= app.uid %></td>
          <td>
            <span class="px-2 py-1 text-xs font-medium rounded-full <%= app.confidential? ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
              <%= app.confidential? ? "Yes" : "No" %>
            </span>
          </td>
          <td><%= app.scopes %></td>
          <td><%= app.created_at.strftime("%b %d, %Y") %></td>
          <td>
            <%= admin_detail_link "View", admin_oauth_application_path(app), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
            <% if current_admin_user&.has_admin_permission?(:manage_oauth) %>
              <%= button_to "Delete", admin_oauth_application_path(app), method: :delete, class: "text-red-600 hover:text-red-900 bg-transparent border-none cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "admin/shared/pagination", collection: @applications %>
</div>
