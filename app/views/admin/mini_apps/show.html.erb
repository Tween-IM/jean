<div class="admin-eyebrow"><%= link_to 'Mini-apps', admin_mini_apps_path %> / App</div><div class="admin-page-heading"><div><h1><%= @mini_app.name %></h1><p><%= @mini_app.app_id %><% if @mini_app.developer_user_id.present? %> · Submitted by <%= @mini_app.developer_user_id %><% end %></p></div><div class="admin-actions"><%= admin_badge(@mini_app.status) %><% if current_admin_user.has_admin_permission?(:manage_mini_apps) %><%= link_to 'Edit configuration', edit_admin_mini_app_path(@mini_app), class: 'admin-button' %><% end %><%= link_to 'Review submission', admin_mini_app_review_path(@mini_app), class: 'admin-button' %></div></div>
<%= render 'configuration' %>
<% if current_admin_user.has_admin_permission?(:manage_mini_apps) %>
<% if @mini_app.approved? %><details class="admin-panel admin-action-panel"><summary class="admin-panel-heading">Activate approved app</summary><%= form_with url: activate_admin_mini_app_path(@mini_app), class: 'admin-panel-body admin-command', data: { turbo_confirm: 'Make this approved app available to customers?' } do |f| %><%= f.label :reason %><%= f.text_area :reason, required: true, minlength: 5, maxlength: 1000, class: 'admin-input' %><%= f.submit 'Activate app', class: 'admin-button admin-button-primary' %><% end %></details><% end %>
<% unless @mini_app.removed? %><details class="admin-panel admin-action-panel"><summary class="admin-panel-heading">Archive app</summary><%= form_with url: admin_mini_app_path(@mini_app), method: :delete, class: 'admin-panel-body admin-command', data: { turbo_confirm: 'Archive this app and remove it from availability?' } do |f| %><%= f.label :reason %><%= f.text_area :reason, required: true, minlength: 5, maxlength: 1000, class: 'admin-input' %><%= f.submit 'Archive app', class: 'admin-button admin-button-danger' %><% end %></details><% end %><% end %>
<section class="admin-panel"><div class="admin-panel-heading"><h2>Installations</h2><span class="admin-badge"><%= @installation_page.total_count %></span></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Person</th><th>Version</th><th>Status</th><th>Installed</th></tr></thead><tbody><% @installations.each do |installation| %><tr><td><% if installation.user && current_admin_user.has_admin_permission?(:view_users) %><%= admin_detail_link installation.user.matrix_username, admin_user_path(installation.user, tab: 'apps') %><% else %>Not linked<% end %></td><td><%= installation.version %></td><td><%= admin_badge(installation.status) %></td><td><%= admin_short_date(installation.created_at) %></td></tr><% end %></tbody></table></div><%= render 'admin/shared/pagination', collection: @installation_page %></section>
