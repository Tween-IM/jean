<section class="admin-panel"><div class="admin-panel-heading"><h2>Launch & permissions</h2><%= admin_badge(@mini_app.classification) %></div><div class="admin-panel-body"><dl class="admin-detail-grid"><% { 'Developer' => @mini_app.developer_name, 'Version' => @mini_app.version, 'Client type' => @mini_app.client_type, 'Launch URL' => @mini_app.manifest&.dig('entry_url'), 'Permissions' => Array(@mini_app.manifest&.dig('scopes')).join(', '), 'OAuth redirects' => Array(@mini_app.manifest&.dig('redirect_uris')).join(', ') }.each do |label, value| %><div><dt><%= label %></dt><dd><%= value.presence || 'Not configured' %></dd></div><% end %></dl><p><%= @mini_app.description %></p></div></section>
<% if @mini_app.bundle.attached? %><section class="admin-panel"><div class="admin-panel-heading"><h2>Signed distribution bundle</h2><%= link_to 'Download package', admin_mini_app_bundle_path(@mini_app), class: 'admin-button', data: { turbo: false } %></div><div class="admin-panel-body"><dl class="admin-detail-grid"><div><dt>Package</dt><dd><%= @mini_app.bundle.filename %> · <%= number_to_human_size(@mini_app.bundle.byte_size) %></dd></div><div><dt>SHA-256</dt><dd><%= @mini_app.manifest.dig('bundle', 'hash') %></dd></div></dl><p class="admin-muted">Signature generated with the platform signing key. Inspect the package before approving distribution.</p></div></section><% end %>
<% if @automated_check %><section class="admin-panel"><div class="admin-panel-heading"><h2>Latest automated check</h2><%= admin_badge(@automated_check.status) %></div><div class="admin-panel-body"><p>Recorded <%= admin_short_date(@automated_check.created_at) %>. Automated checks do not replace a manual review.</p></div></section><% else %><p class="admin-muted">No automated scan is recorded for this submission. Package storage and signing do not constitute a security scan.</p><% end %>

<% if @mini_app.previous_bundles.attached? %><section class="admin-panel"><div class="admin-panel-heading"><h2>Previous packages</h2></div><div class="admin-panel-body"><% @mini_app.previous_bundles.each do |bundle| %><p><%= link_to bundle.filename, rails_blob_path(bundle, disposition: 'attachment'), data: { turbo: false } %> · <%= number_to_human_size(bundle.byte_size) %></p><% end %></div></section><% end %>
