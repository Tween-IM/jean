<div class="mb-8">
  <h1 class="admin-title text-3xl font-bold text-slate-900">Mini Apps</h1>
  <p class="text-slate-500 mt-1">Manage mini-app availability, ownership and release information.</p>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden admin-panel">
  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">App ID</th>
        <th scope="col">Classification</th>
        <th scope="col">Status</th>
        <th scope="col">Version</th>
        <th scope="col">Installs</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @mini_apps.records.each do |app| %>
        <tr class="hover:bg-slate-50">
          <td>
            <div class="text-sm font-medium text-slate-900"><%= app.name %></div>
            <div class="text-sm text-slate-500"><%= app.developer_name %></div>
          </td>
          <td><%= app.app_id %></td>
          <td>
            <span class="px-2 py-1 text-xs font-medium rounded-full
              <%= case app.classification
                  when 'official' then 'bg-purple-100 text-purple-700'
                  when 'verified' then 'bg-blue-100 text-blue-700'
                  when 'community' then 'bg-green-100 text-green-700'
                  when 'beta' then 'bg-amber-100 text-amber-700'
                  else 'bg-slate-100 text-slate-700'
                  end %>">
              <%= app.classification %>
            </span>
          </td>
          <td>
            <span class="px-2 py-1 text-xs font-medium rounded-full <%= app.active? ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
              <%= app.status %>
            </span>
          </td>
          <td><%= app.version %></td>
          <td><%= number_with_delimiter(app.install_count) %></td>
          <td>
            <%= admin_detail_link "View", admin_mini_app_path(app), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
            <% if current_admin_user&.has_admin_permission?(:manage_mini_apps) %>
              <%= link_to "Edit", edit_admin_mini_app_path(app), class: "text-indigo-600 hover:text-indigo-900" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "admin/shared/pagination", collection: @mini_apps %>
</div>
