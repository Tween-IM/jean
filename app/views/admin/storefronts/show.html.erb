<% content_for :title, "#{@storefront.display_name} — Storefront" %>
<% content_for :page_title, "Storefronts" %>

<% can_manage = current_admin_user.has_admin_permission?(:manage_storefronts) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-3">
      <%= store_mark(@storefront, size: "w-10 h-10") %>
      <h1 class="text-xl font-semibold text-gray-900 truncate"><%= @storefront.display_name %></h1>
      <%= entity_status_badge(@storefront.status) %>
      <% if @storefront.featured %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">featured</span>
      <% end %>
      <% if @storefront.source_platform.present? %>
        <%= platform_badge(@storefront.source_platform) %>
        <%= source_kind_badge(@storefront.source_kind) %>
      <% end %>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      <span class="font-mono"><%= @storefront.slug %></span>
      · <%= number_with_delimiter(@product_count) %> listings
      · <%= number_with_delimiter(@order_count) %> orders
      · <%= @storefront.store_type == "ecommerce" ? "sells on-platform" : "classified (contact the seller)" %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "← All stores", admin_storefronts_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
    <%= link_to "Merchant", admin_merchant_path(@merchant), class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <%= form_with model: @storefront, url: admin_storefront_path(@storefront), method: :patch,
        html: { multipart: true }, class: "bg-white rounded-xl border border-gray-200" do |form| %>
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Store settings</h2>
        <p class="text-xs text-gray-500 mt-0.5">Branding, copy and how buyers reach this store</p>
      </div>

      <div class="p-5 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= form.label :display_name, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :display_name, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :accent_color, "Accent colour", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :accent_color, placeholder: "#4F46E5", class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 font-mono" %>
          </div>
          <div>
            <%= form.label :status, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.select :status, %w[draft published suspended closed].map { |status| [ status.humanize, status ] }, {},
                class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :store_type, "Experience", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.select :store_type, [ [ "Store — cart and checkout", "ecommerce" ], [ "Classified — buyer messages the seller", "marketplace" ] ], {},
                class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex items-end gap-2">
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
              <%= form.check_box :featured, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              Featured
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
              <%= form.check_box :allow_promotion, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              Allows promotion
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
              <%= form.check_box :social_share_enabled, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              Shareable
            </label>
          </div>
        </div>

        <div>
          <%= form.label :about, "About", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
          <%= form.text_area :about, rows: 3, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= form.label :description, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
          <%= form.text_area :description, rows: 3, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Branding</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-lg border border-gray-200 p-3">
              <p class="text-xs text-gray-500 mb-2">Logo</p>
              <div class="flex items-center gap-3 mb-2">
                <%= store_mark(@storefront, size: "w-12 h-12") %>
                <p class="text-xs text-gray-500">
                  <% if @storefront.logo_url.present? %>
                    <span class="font-mono break-all"><%= @storefront.logo_url.split("/").last %></span>
                  <% else %>
                    No logo — the shop draws a monogram.
                  <% end %>
                </p>
              </div>
              <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp,image/gif",
                  class: "block w-full text-xs text-gray-600 file:mr-2 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" %>
              <% if @storefront.logo_url.present? %>
                <label class="mt-2 inline-flex items-center gap-2 text-xs text-gray-600">
                  <%= check_box_tag "commerce_storefront[remove_logo_url]", "1", false, class: "rounded border-gray-300 text-red-600 focus:ring-red-500" %>
                  Remove current logo
                </label>
              <% end %>
            </div>
            <div class="rounded-lg border border-gray-200 p-3">
              <p class="text-xs text-gray-500 mb-2">Banner</p>
              <% if @storefront.banner_url.present? %>
                <%= image_tag @storefront.banner_url, alt: "", class: "w-full h-20 object-cover rounded-lg border border-gray-200 mb-2" %>
              <% else %>
                <div class="w-full h-20 rounded-lg bg-gradient-to-r from-gray-100 to-gray-200 mb-2 flex items-center justify-center"
                     style="background-color: <%= @storefront.accent_color.presence || '#E5E7EB' %>20;">
                  <span class="text-xs text-gray-500">No banner</span>
                </div>
              <% end %>
              <%= form.file_field :banner, accept: "image/png,image/jpeg,image/webp,image/gif",
                  class: "block w-full text-xs text-gray-600 file:mr-2 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-indigo-700 hover:file:bg-indigo-100" %>
              <% if @storefront.banner_url.present? %>
                <label class="mt-2 inline-flex items-center gap-2 text-xs text-gray-600">
                  <%= check_box_tag "commerce_storefront[remove_banner_url]", "1", false, class: "rounded border-gray-300 text-red-600 focus:ring-red-500" %>
                  Remove current banner
                </label>
              <% end %>
            </div>
          </div>
          <p class="mt-2 text-xs text-gray-400">
            Uploads go to the shared bucket under <span class="font-mono">commerce/storefronts/…</span>.
            Mirrored sellers publish no logo of their own, so this is the only way a store gets one.
          </p>
        </div>

        <div>
          <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Contact</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :contact_phone, "Phone", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_phone, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :contact_email, "Email", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_email, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :contact_website, "Website", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_website, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :contact_address, "Address", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_address, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
          </div>
        </div>
      </div>

      <% if can_manage %>
        <div class="px-5 py-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs text-gray-400 max-w-md">Re-imports refresh branding from the source; nothing here is overwritten with blanks.</p>
          <%= form.submit "Save store", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg" %>
        </div>
      <% end %>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Listings</h2>
          <p class="text-xs text-gray-500 mt-0.5">Showing the <%= [ @products.size, @product_count ].min %> most recent</p>
        </div>
        <%= link_to admin_products_path(storefront: @storefront.id), class: "text-xs font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1" do %>
          All listings <%= fluent_icon "chevron_right", class: "w-3 h-3" %>
        <% end %>
      </div>
      <% if @products.any? %>
        <table class="min-w-full divide-y divide-gray-100">
          <tbody class="divide-y divide-gray-100">
            <% @products.each do |product| %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <%= product_thumb(product) %>
                    <div class="min-w-0">
                      <div class="text-sm text-gray-900 truncate"><%= product.title %></div>
                      <div class="text-xs text-gray-500 font-mono"><%= product.product_id %></div>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3 text-right text-sm text-gray-700 whitespace-nowrap"><%= pricing_label(product) %></td>
                <td class="px-5 py-3 text-right"><%= entity_status_badge(product.status) %></td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "Open", admin_product_path(product), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-5 py-8 text-center text-sm text-gray-500">This store has no listings yet.</div>
      <% end %>
    </div>

    <% if @orders.any? %>
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Recent orders</h2>
          <%= link_to admin_orders_path(merchant: @merchant.merchant_id), class: "text-xs font-medium text-indigo-600 hover:text-indigo-700" do %>
            All <%= number_with_delimiter(@order_count) %> orders
          <% end %>
        </div>
        <table class="min-w-full divide-y divide-gray-100">
          <tbody class="divide-y divide-gray-100">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3 text-sm font-mono text-gray-900"><%= order.order_id %></td>
                <td class="px-5 py-3 text-sm text-gray-600 truncate max-w-[12rem]"><%= order.buyer_user_id %></td>
                <td class="px-5 py-3 text-sm text-gray-900"><%= money(order.total_cents, order.currency) %></td>
                <td class="px-5 py-3"><%= order_status_badge(order.status) %></td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "Manage", admin_order_path(order), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- Right: provenance and quick actions -->
  <div class="space-y-6">
    <% if can_manage %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Quick actions</h2>
        </div>
        <div class="p-5 space-y-3">
          <%= button_to "Pull branding from the source", enrich_admin_storefront_path(@storefront),
              class: "w-full px-3 py-2 text-sm font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg",
              form: { data: { turbo: false } } %>
          <p class="text-xs text-gray-400">
            Reads this store's own listings for the banner, description and location the importer stored
            but never applied. Fills blanks only.
          </p>
          <%= button_to (@storefront.featured ? "Remove from featured" : "Feature this store"), feature_admin_storefront_path(@storefront),
              class: "w-full px-3 py-2 text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-lg",
              form: { data: { turbo: false } } %>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Merchant</h2>
      </div>
      <div class="px-5 py-4 space-y-1 text-sm">
        <p class="text-gray-900"><%= @merchant.display_name %></p>
        <p class="text-xs text-gray-500 font-mono"><%= @merchant.merchant_id %></p>
        <% if @merchant.system_owned? %>
          <p class="text-xs text-indigo-600">Platform owned — no merchant app drives it.</p>
        <% end %>
        <p class="text-xs text-gray-500">
          commission <%= (@merchant.commission_rate.to_i / 100.0).round(2) %>%
        </p>
        <%= link_to "Open merchant", admin_merchant_path(@merchant), class: "text-xs font-medium text-indigo-600 hover:text-indigo-800" %>
      </div>
    </div>

    <% if @contact_channels.any? %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">How to reach them</h2>
        </div>
        <div class="px-5 py-4 space-y-2 text-sm">
          <% @contact_channels.each do |label, value| %>
            <div>
              <p class="text-xs text-gray-500"><%= label %></p>
              <p class="text-gray-900 break-words"><%= value %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="bg-white rounded-xl border border-amber-200 bg-amber-50">
        <div class="px-5 py-4">
          <h2 class="text-sm font-semibold text-amber-900">No contact on file</h2>
          <p class="mt-1 text-xs text-amber-800">
            The source published no way to reach this seller. Add what the outreach team finds.
          </p>
        </div>
      </div>
    <% end %>

    <% if @storefront.source_platform.present? %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Provenance</h2>
        </div>
        <div class="px-5 py-4 space-y-2 text-sm">
          <div class="flex justify-between gap-2">
            <span class="text-gray-500">Platform</span>
            <span class="text-gray-900"><%= @storefront.source_platform %></span>
          </div>
          <div class="flex justify-between gap-2">
            <span class="text-gray-500">Kind</span>
            <span class="text-gray-900"><%= @storefront.source_kind || "store" %></span>
          </div>
          <div class="flex justify-between gap-2">
            <span class="text-gray-500">Source id</span>
            <span class="text-gray-900 font-mono text-xs truncate"><%= @storefront.source_id %></span>
          </div>
          <div>
            <p class="text-gray-500 text-xs">Last synced</p>
            <p class="text-gray-900"><%= @storefront.source_synced_at ? "#{time_ago_in_words(@storefront.source_synced_at)} ago" : "never" %></p>
          </div>
          <% if @storefront.source_url.present? %>
            <div>
              <p class="text-gray-500 text-xs">Source URL</p>
              <%= link_to @storefront.source_url, @storefront.source_url, target: "_blank", rel: "noopener",
                  class: "text-indigo-600 hover:text-indigo-800 text-xs break-all" %>
            </div>
          <% end %>
          <% if @source.any? %>
            <details class="pt-2">
              <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-700">Raw source payload</summary>
              <pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-gray-50 border border-gray-200 p-2 text-xs text-gray-700"><%= JSON.pretty_generate(@source) %></pre>
            </details>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
