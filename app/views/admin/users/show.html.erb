<% content_for :title, "#{@user.matrix_username} · Tween Admin" %>
<div class="admin-eyebrow"><%= link_to 'People', admin_users_path %> / Person</div>
<div class="admin-page-heading">
  <div>
    <h1><%= @user.matrix_username %></h1>
    <p><%= @user.matrix_user_id %></p>
  </div>
  <% if current_admin_user.has_admin_permission?(:manage_users) %><%= link_to 'Manage account', edit_admin_user_path(@user), class: 'admin-button' %><% end %></div>
<nav class="admin-tabs" aria-label="Person sections"><% @tabs.each do |key, label| %><%= link_to label, admin_user_path(@user, tab: key), class: 'admin-tab', aria: { current: @tab == key ? 'page' : nil } %><% end %></nav>
<% if @remote_error %>
  <section class="admin-panel"><%= render 'admin/shared/unavailable', message: @remote_error %></section>
<% elsif @tab == 'profile' %>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <h2>Account overview</h2>
      <%= admin_badge(@user.status) %></div>
    <div class="admin-panel-body">
      <dl class="admin-detail-grid">
        <% { 'Matrix ID' => @user.matrix_user_id, 'Homeserver' => @user.matrix_homeserver, 'Identity ID' => @user.mas_user_id, 'Staff role' => @user.platform_role.humanize, 'Joined' => @user.created_at.strftime('%d %B %Y'), 'Local account status' => @user.status.humanize }.each do |label, value| %>
          <div>
            <dt><%= label %></dt>
            <dd><%= value.presence || 'Not linked' %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>
<% elsif @tab == 'payments' %>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <h2>Payment account</h2><%= admin_detail_link "Manage payment account →", admin_resource_record_path("payment_accounts", @remote.dig("user", "id")), class: "admin-button" %>
      <%= admin_badge(@remote.dig('user', 'status')) %></div>
    <div class="admin-panel-body">
      <dl class="admin-detail-grid">
        <div>
          <dt>Payment user ID</dt>
          <dd><%= @remote.dig('user', 'id') %></dd>
        </div>
        <div>
          <dt>KYC tier</dt>
          <dd><%= @remote.dig('user', 'kyc_tier') %></dd>
        </div>
      </dl>
    </div>
  </section>
  <% { 'wallets' => 'Wallets', 'transactions' => 'Recent transactions' }.each do |key, label| %><% next unless @remote.key?(key) %>
    <section class="admin-panel">
      <div class="admin-panel-heading">
        <h2><%= label %></h2>
      </div>
      <%= render 'admin/shared/resource_table', records: @remote[key], fields: Admin::Resources::CATALOG.fetch(key)[:fields], resource_key: key %></section>
  <% end %>
<% elsif @tab == 'apps' %>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <h2>Mini-app installations</h2>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>App</th>
            <th>Version</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody><% @installations.each do |installation| %>
            <tr>
              <td><%= installation.mini_app&.name || installation.mini_app_id %></td>
              <td><%= installation.version %></td>
              <td><%= admin_badge(installation.status) %></td>
            </tr>
          <% end %></tbody>
      </table>
    </div>
    <% if @installations.empty? %>
      <div class="admin-empty">No apps installed yet.</div>
    <% end %></section>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <h2>Registered authentication methods</h2>
    </div>
    <div class="admin-panel-body"><% @mfa_methods.each do |method| %>
        <p><%= method.method_type %> · <%= method.enabled? ? 'Enabled' : 'Disabled' %></p>
      <% end %><% if @mfa_methods.empty? %>
        <p>No methods registered in this account.</p>
      <% end %></div>
  </section>
  <% if @storage_entries %>
    <section class="admin-panel">
      <div class="admin-panel-heading">
        <h2>Recent app storage</h2>
      </div>
      <div class="admin-panel-body">
        <p><%= @storage_entries.size %> recent entries. Storage values are not displayed in the staff workspace.</p>
      </div>
    </section>
  <% end %>
<% elsif @tab == 'commerce' %>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <h2>Recent orders</h2>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Status</th>
            <th>Placed</th>
            <th></th>
          </tr>
        </thead>
        <tbody><% @orders.each do |order| %>
            <tr>
              <td><%= order.id %></td>
              <td><%= admin_badge(order.status) %></td>
              <td><%= order.created_at.strftime('%d %b %Y') %></td>
              <td><%= link_to 'Open →', admin_order_path(order) %></td>
            </tr>
          <% end %></tbody>
      </table>
    </div>
    <% if @orders.empty? %>
      <div class="admin-empty">No orders for this person yet.</div>
    <% end %></section>
<% else %>
  <section class="admin-panel">
    <div class="admin-panel-heading">
      <h2><%= @tabs[@tab] %> account</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-grid"><% @remote.each do |key, value| %>
          <div>
            <dt><%= key.humanize %></dt>
            <dd><%= admin_value(value, key, @remote) %></dd>
          </div>
        <% end %></dl>
    </div>
  </section>
<% end %>
<% if @tab == 'identity' && !@remote_error && current_admin_user.has_admin_permission?(:manage_identity) %>
  <% %w[lock unlock].each do |operation| %>
    <details class="admin-panel"><summary class="admin-panel-heading"><%= operation.humanize %> identity account</summary><%= form_with url: identity_command_admin_user_path(@user), class: 'admin-panel-body admin-command' do |form| %>
        <p class="mb-4">This changes sign-in access for this identity account. Payment restrictions and messaging account status are managed separately.</p>
        <%= form.hidden_field :operation, value: operation %><%= form.label :reason, 'Reason for this action', for: "identity-reason-#{operation}" %><%= form.text_area :reason, class: 'admin-input', required: true, minlength: 5, maxlength: 1000, id: "identity-reason-#{operation}" %><%= form.submit "Confirm: #{operation} account", class: 'admin-button admin-button-danger' %><% end %></details>
  <% end %>
<% end %>
