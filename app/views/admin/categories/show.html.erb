<div class="admin-eyebrow"><%= link_to 'Categories', admin_categories_path %> / Category</div><div class="admin-page-heading"><div><h1><%= @category.name %></h1><p><%= @product_count %> products · <%= @child_count %> child categories</p></div><%= admin_badge(@category.status) %></div>
<section class="admin-panel"><div class="admin-panel-heading"><h2>Category details</h2></div><div class="admin-panel-body"><% if current_admin_user.has_admin_permission?(:manage_categories) %><%= form_with model: @category, url: admin_category_path(@category), class: 'admin-form-grid' do |f| %><div class="admin-form-field"><%= f.label :name %><%= f.text_field :name, required: true, class: 'admin-input' %></div><div class="admin-form-field"><%= f.label :parent_id, 'Parent category' %><%= f.collection_select :parent_id, @parents, :id, :name, { include_blank: 'Top level' }, class: 'admin-input admin-select' %></div><div class="admin-form-field"><%= f.label :status %><%= f.select :status, [['Active', 'active'], ['Inactive', 'inactive']], {}, class: 'admin-input admin-select' %></div><div class="admin-form-field"><%= f.label :sort_order %><%= f.number_field :sort_order, class: 'admin-input' %></div><div class="admin-form-field admin-form-field-wide"><%= f.label :description %><%= f.text_area :description, class: 'admin-input', rows: 3 %></div><div><%= f.submit 'Save changes', class: 'admin-button admin-button-primary' %></div><% end %><% else %><p><%= @category.description %></p><% end %></div></section>
<%= link_to 'View products in this category', admin_products_path(category: @category.id), class: 'admin-button' %>
