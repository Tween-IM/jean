<% content_for :title, 'Sign in · Tween Admin' %>
<h1>Welcome back</h1>
<p>Sign in to your Tween staff workspace.</p>
<% if Admin::MasOidc.configured? %><%= link_to 'Continue with Tween ID →', admin_mas_login_path, class: 'admin-button admin-button-primary' %><% end %>
<% if !Rails.env.production? || ENV['ADMIN_ACCESS_TOKEN'].present? %>
  <details style="margin-top:24px"><summary style="font-size:12px;cursor:pointer">Emergency staff access</summary>
    <%= form_with url: admin_login_path do |form| %><%= form.label :matrix_user_id, 'Matrix ID' %><%= form.text_field :matrix_user_id, required: true, class: 'admin-input', autocomplete: 'username' %><%= form.label :admin_token, 'Access token' %><%= form.password_field :admin_token, class: 'admin-input', autocomplete: 'current-password' %><%= form.submit 'Sign in', class: 'admin-button' %><% end %></details>
<% end %>
