<h1>Two-Factor Authentication</h1>
<p>Enter the six-digit code from your authenticator app.</p>
<%= form_with url: admin_mfa_path do |form| %><%= form.label :mfa_code, 'Authentication code' %><%= form.text_field :mfa_code, required: true, class: 'admin-input', inputmode: 'numeric', autocomplete: 'one-time-code', pattern: '[0-9]{6}', maxlength: 6 %><%= form.submit 'Verify and continue', class: 'admin-button admin-button-primary' %><% end %>
