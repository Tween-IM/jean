<div class="admin-pagination">
  <span><% if collection.total_count.zero? %>No results<% else %><strong><%= number_with_delimiter((collection.current_page - 1) * collection.limit_value + 1) %>–<%= number_with_delimiter([collection.current_page * collection.limit_value, collection.total_count].min) %></strong> of <%= number_with_delimiter(collection.total_count) %> results<% end %></span>
  <nav class="admin-actions" aria-label="Pagination">
    <% if collection.current_page > 1 %><%= link_to "← Previous", url_for(request.query_parameters.merge(page: collection.current_page - 1)), class: "admin-button" %><% end %>
    <span>Page <%= collection.current_page %> of <%= [collection.total_pages, 1].max %></span>
    <% if collection.current_page < collection.total_pages %><%= link_to "Next →", url_for(request.query_parameters.merge(page: collection.current_page + 1)), class: "admin-button" %><% end %>
  </nav>
</div>
