<% content_for :title, "Orders — TMCP Admin" %>
<% content_for :page_title, "Orders" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-xl font-semibold text-gray-900">Orders</h1>
    <p class="mt-1 text-sm text-gray-500">
      Every order on the platform, including the ones the system merchant owns —
      those have no merchant app driving them, so this is where they move.
    </p>
  </div>
  <%= link_to "← Dashboard", admin_dashboard_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
</div>

<div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-5">
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Open</p>
    <p class="mt-1 text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@stats[:open]) %></p>
    <p class="mt-0.5 text-xs text-gray-500"><%= number_with_delimiter(@stats[:total]) %> total</p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Needs fulfilment</p>
    <p class="mt-1 text-2xl font-semibold <%= @stats[:needs_fulfillment].positive? ? 'text-amber-600' : 'text-gray-900' %>"><%= number_with_delimiter(@stats[:needs_fulfillment]) %></p>
    <p class="mt-0.5 text-xs text-gray-500">Paid, nothing shipped</p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Unpaid</p>
    <p class="mt-1 text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@stats[:unpaid]) %></p>
    <p class="mt-0.5 text-xs text-gray-500">Awaiting payment</p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">System merchant</p>
    <p class="mt-1 text-2xl font-semibold <%= @stats[:system_open].positive? ? 'text-indigo-600' : 'text-gray-900' %>"><%= number_with_delimiter(@stats[:system_open]) %></p>
    <p class="mt-0.5 text-xs text-gray-500">Open imported orders</p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Value · 30d</p>
    <p class="mt-1 text-xl font-semibold text-gray-900"><%= money(@stats[:gmv_30d_cents]) %></p>
    <p class="mt-0.5 text-xs text-gray-500"><%= money(@stats[:refunded_30d_cents]) %> refunded</p>
  </div>
</div>

<%= form_with url: admin_orders_path, method: :get, class: "mb-4 bg-white rounded-xl border border-gray-200 p-4" do %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Search</label>
      <input type="text" name="query" value="<%= params[:query] %>" placeholder="Order, payment or buyer"
        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Status</label>
      <select name="status" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">All</option>
        <% @statuses.each do |status| %>
          <option value="<%= status %>" <%= "selected" if params[:status] == status %>><%= status.humanize %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Fulfilment</label>
      <select name="fulfillment_status" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">All</option>
        <% @fulfillment_statuses.each do |status| %>
          <option value="<%= status %>" <%= "selected" if params[:fulfillment_status] == status %>><%= status.humanize %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Merchant</label>
      <select name="merchant" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">All</option>
        <option value="system" <%= "selected" if params[:merchant] == "system" %>>System merchant (imports)</option>
        <% @merchants.each do |merchant| %>
          <option value="<%= merchant.merchant_id %>" <%= "selected" if params[:merchant] == merchant.merchant_id %>><%= merchant.display_name %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Source</label>
      <select name="source" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">All</option>
        <% @sources.each do |source| %>
          <option value="<%= source %>" <%= "selected" if params[:source] == source %>><%= source.humanize %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Period</label>
      <select name="period" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Any time</option>
        <% @periods.each do |period| %>
          <option value="<%= period %>" <%= "selected" if params[:period] == period %>>Last <%= period %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Sort</label>
      <select name="sort" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="newest" <%= "selected" if params[:sort].blank? || params[:sort] == "newest" %>>Newest first</option>
        <option value="oldest" <%= "selected" if params[:sort] == "oldest" %>>Oldest first</option>
        <option value="value" <%= "selected" if params[:sort] == "value" %>>Highest value</option>
      </select>
    </div>
    <div class="flex items-end gap-3">
      <label class="inline-flex items-center gap-2 text-sm text-gray-700 pb-2">
        <input type="checkbox" name="attention" value="1" <%= "checked" if params[:attention] == "1" %>
          class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
        Needs attention
      </label>
      <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg">Filter</button>
      <%= link_to "Reset", admin_orders_path, class: "px-3 py-2 text-sm text-gray-600 hover:text-gray-900" %>
    </div>
  </div>
<% end %>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <% if @orders.records.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Buyer</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Merchant</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fulfilment</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% @orders.records.each do |order| %>
          <tr class="hover:bg-gray-50">
            <td class="px-5 py-3">
              <div class="text-sm font-medium text-gray-900 font-mono"><%= order.order_id %></div>
              <div class="text-xs text-gray-500"><%= order.created_at.strftime("%d %b %Y, %H:%M") %> · <%= order.commerce_order_items.size %> item(s)</div>
            </td>
            <td class="px-5 py-3 text-sm text-gray-700 truncate max-w-[14rem]"><%= order.buyer_user_id %></td>
            <td class="px-5 py-3">
              <div class="text-sm text-gray-900"><%= order.commerce_merchant.display_name %></div>
              <% if order.commerce_merchant.system_owned? %>
                <span class="text-xs text-indigo-600">system merchant</span>
              <% elsif order.commerce_merchant.owner_user_id.blank? %>
                <span class="text-xs text-amber-600">no owner</span>
              <% end %>
            </td>
            <td class="px-5 py-3 text-sm text-gray-900"><%= money(order.total_cents, order.currency) %></td>
            <td class="px-5 py-3">
              <%= order_status_badge(order.status) %>
              <% if order.protected_payment_id.present? %>
                <div class="mt-1"><%= protection_badge(order.protection_status) %></div>
              <% end %>
            </td>
            <td class="px-5 py-3"><%= fulfillment_status_badge(order.fulfillment_status) %></td>
            <td class="px-5 py-3 text-right">
              <%= link_to "Manage", admin_order_path(order), class: "text-sm font-medium text-indigo-600 hover:text-indigo-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/shared/pagination", collection: @orders %>
  <% else %>
    <div class="p-12 text-center">
      <p class="text-sm text-gray-500">No orders match this filter.</p>
    </div>
  <% end %>
</div>
