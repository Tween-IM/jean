<% content_for :title, "#{@order.order_id} — Order" %>
<% content_for :page_title, "Orders" %>

<% can_manage = current_admin_user.has_admin_permission?(:manage_orders) %>
<% can_refund = current_admin_user.has_admin_permission?(:manage_refunds) %>
<% events_by_fulfillment = @events.group_by(&:commerce_fulfillment_id) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-xl font-semibold text-gray-900 font-mono"><%= @order.order_id %></h1>
      <%= order_status_badge(@order.status) %>
      <%= fulfillment_status_badge(@order.fulfillment_status) %>
      <% if @order.protected_payment_id.present? %>
        <%= protection_badge(@order.protection_status) %>
      <% end %>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      <%= @order.created_at.strftime("%d %b %Y, %H:%M") %>
      · <%= @order.source.humanize %> · <%= @order.fulfillment_type.humanize %>
      · payment <span class="font-mono"><%= @order.payment_id %></span>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "← All orders", admin_orders_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
    <%= link_to "Merchant", admin_merchant_path(@merchant), class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Left: what was ordered and what has happened -->
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Items</h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= @items.size %> line item(s)</p>
      </div>
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-5 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
            <th class="px-5 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Qty</th>
            <th class="px-5 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Unit</th>
            <th class="px-5 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Line</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @items.each do |item| %>
            <% product = @products_by_id[item.product_id] %>
            <tr>
              <td class="px-5 py-3">
                <div class="flex items-center gap-3">
                  <% if product %>
                    <%= product_thumb(product) %>
                  <% end %>
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-gray-900 truncate"><%= item.product_name.presence || product&.title || item.title %></div>
                    <% if item.variant_attributes.present? %>
                      <div class="text-xs text-gray-500"><%= Array(item.variant_attributes).join(" · ") %></div>
                    <% end %>
                    <div class="text-xs text-gray-400 font-mono"><%= item.product_id %></div>
                  </div>
                </div>
              </td>
              <td class="px-5 py-3 text-right text-sm text-gray-700"><%= item.quantity %></td>
              <td class="px-5 py-3 text-right text-sm text-gray-700"><%= money(item.unit_price_cents, item.currency) %></td>
              <td class="px-5 py-3 text-right text-sm font-medium text-gray-900"><%= money(item.line_total_cents, item.currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="px-5 py-4 border-t border-gray-100 space-y-1 text-sm">
        <div class="flex justify-between text-gray-600"><span>Subtotal</span><span><%= money(@order.subtotal_cents, @order.currency) %></span></div>
        <% if @order.discount_cents.positive? %>
          <div class="flex justify-between text-emerald-700"><span>Discount</span><span>-<%= money(@order.discount_cents, @order.currency) %></span></div>
        <% end %>
        <div class="flex justify-between text-gray-600"><span>Shipping</span><span><%= money(@order.shipping_cents, @order.currency) %></span></div>
        <% if @order.tax_cents.positive? %>
          <div class="flex justify-between text-gray-600"><span>Tax</span><span><%= money(@order.tax_cents, @order.currency) %></span></div>
        <% end %>
        <div class="flex justify-between text-base font-semibold text-gray-900 pt-2 border-t border-gray-100"><span>Total</span><span><%= money(@order.total_cents, @order.currency) %></span></div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Fulfilments</h2>
        <p class="text-xs text-gray-500 mt-0.5">Everything the seller or the platform has recorded against this order</p>
      </div>
      <% if @fulfillments.any? %>
        <div class="divide-y divide-gray-100">
          <% @fulfillments.each do |fulfillment| %>
            <div class="px-5 py-4">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-gray-900"><%= fulfillment.kind.humanize %></span>
                  <%= entity_status_badge(fulfillment.status) %>
                  <span class="text-xs text-gray-400 font-mono"><%= fulfillment.fulfillment_id %></span>
                </div>
                <span class="text-xs text-gray-500">
                  <%= fulfillment.shipped_at&.strftime("%d %b, %H:%M") || fulfillment.created_at.strftime("%d %b, %H:%M") %>
                </span>
              </div>
              <% if fulfillment.provider.present? || fulfillment.tracking_number.present? %>
                <p class="mt-1 text-sm text-gray-600">
                  <%= fulfillment.provider.presence || "carrier" %>
                  <% if fulfillment.tracking_number.present? %>
                    · <span class="font-mono"><%= fulfillment.tracking_number %></span>
                  <% end %>
                  <% if fulfillment.tracking_url.present? %>
                    · <%= link_to "track", fulfillment.tracking_url, class: "text-indigo-600 hover:text-indigo-800", target: "_blank", rel: "noopener" %>
                  <% end %>
                </p>
              <% end %>
              <% events = events_by_fulfillment[fulfillment.id] || [] %>
              <% if events.any? %>
                <ul class="mt-2 space-y-1">
                  <% events.each do |event| %>
                    <li class="text-xs text-gray-500">
                      <span class="font-medium text-gray-700"><%= event.event_type %></span>
                      · <%= event.occurred_at.strftime("%d %b %H:%M") %>
                      <% if event.actor_user_id.present? %>
                        · <span class="font-mono"><%= event.actor_user_id %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-5 py-6 text-sm text-gray-500">Nothing shipped or handed over yet.</div>
      <% end %>
    </div>

    <% if @refunds.any? %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Refunds</h2>
        </div>
        <div class="divide-y divide-gray-100">
          <% @refunds.each do |refund| %>
            <div class="px-5 py-3 flex items-center justify-between text-sm">
              <div>
                <span class="font-medium text-gray-900"><%= money(refund["amount_cents"], @order.currency) %></span>
                <span class="text-gray-500"> · <%= refund["reason"].presence || "refund" %></span>
                <% if refund["channel"].present? %>
                  <span class="text-xs text-gray-400">(<%= refund["channel"] %>)</span>
                <% end %>
              </div>
              <span class="text-xs text-gray-500">
                <%= refund["created_at"].to_s.first(16) %> · <span class="font-mono"><%= refund["processed_by"] %></span>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @disputes.any? %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Disputes</h2>
        </div>
        <div class="divide-y divide-gray-100">
          <% @disputes.each do |dispute| %>
            <div class="px-5 py-3 text-sm">
              <div class="flex items-center gap-2">
                <span class="font-medium text-gray-900"><%= dispute.reason %></span>
                <%= entity_status_badge(dispute.status) %>
              </div>
              <p class="mt-1 text-gray-600"><%= dispute.description.to_s.truncate(280) %></p>
              <p class="mt-1 text-xs text-gray-500">
                opened <%= dispute.opened_at.strftime("%d %b %Y") %> by <span class="font-mono"><%= dispute.opened_by_user_id %></span>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Right: who, where the money is, what to do next -->
  <div class="space-y-6">
    <% if can_manage || can_refund %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Actions</h2>
          <p class="text-xs text-gray-500 mt-0.5">Every action is audit logged against your admin account</p>
        </div>
        <div class="p-5 space-y-5">
          <% if can_manage %>
            <div>
              <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Move the order</h3>
              <% if @next_statuses.any? %>
                <%= form_with url: transition_admin_order_path(@order), method: :post, class: "flex items-center gap-2" do %>
                  <select name="status" class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <% @next_statuses.each do |status| %>
                      <option value="<%= status %>"><%= status.humanize %></option>
                    <% end %>
                  </select>
                  <button type="submit" class="px-3 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg">Apply</button>
                <% end %>
                <p class="mt-1 text-xs text-gray-400">
                  From <span class="font-medium"><%= @order.status.humanize %></span> the model allows only these moves.
                  Cancelling does not move money — refund separately.
                </p>
              <% else %>
                <p class="text-sm text-gray-500">This order is in a terminal state (<%= @order.status.humanize %>).</p>
              <% end %>
            </div>

            <div class="pt-5 border-t border-gray-100">
              <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Fulfilment</h3>
              <%= form_with url: fulfillment_admin_order_path(@order), method: :post, class: "space-y-2" do %>
                <select name="fulfillment_action" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                  <option value="ship">Record a shipment</option>
                  <option value="deliver">Mark as delivered (seller side)</option>
                  <option value="ready_for_pickup">Ready for pickup</option>
                  <option value="confirm_pickup">Confirm pickup (needs the buyer's code)</option>
                  <option value="confirm">Confirm delivery on the buyer's behalf</option>
                  <option value="accept">Accept delivery on the buyer's behalf</option>
                </select>
                <input type="text" name="carrier" placeholder="Carrier (shipment only)"
                  class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
                <input type="text" name="tracking_number" placeholder="Tracking number"
                  class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
                <input type="text" name="tracking_url" placeholder="Tracking URL"
                  class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
                <input type="text" name="pickup_code" placeholder="Pickup code"
                  class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
                <input type="text" name="note" placeholder="Note (kept on the fulfilment)"
                  class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
                <button type="submit" class="w-full px-3 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg">
                  Apply fulfilment step
                </button>
              <% end %>
              <p class="mt-1 text-xs text-gray-400">
                Confirming or accepting on the buyer's behalf schedules the payout release — it is logged as a platform action.
              </p>
            </div>
          <% end %>

          <% if can_refund %>
            <div class="pt-5 border-t border-gray-100">
              <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Refund</h3>
              <% if @order.protected_payment_id.present? %>
                <%= form_with url: refund_admin_order_path(@order), method: :post, class: "space-y-2" do %>
                  <input type="number" name="amount_cents" step="1" min="1" max="<%= @order.total_cents %>" value="<%= @order.total_cents %>"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                  <input type="text" name="reason" placeholder="Reason"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
                  <button type="submit" class="w-full px-3 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg">
                    Refund <%= money(@order.total_cents, @order.currency) %> or less
                  </button>
                  <p class="text-xs text-gray-400">Amount is in minor units (kobo). This moves money in Tween Pay.</p>
                <% end %>
              <% else %>
                <p class="text-sm text-gray-500">
                  This order is not a protected payment, so Tween Pay can only refund it with the merchant's own
                  authorisation — ask the merchant to refund from their app.
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Buyer</h2>
      </div>
      <div class="px-5 py-4 space-y-1 text-sm">
        <p class="font-mono text-gray-900"><%= @order.buyer_user_id %></p>
        <% if @buyer %>
          <p class="text-gray-600"><%= @buyer.matrix_username %></p>
          <p class="text-xs text-gray-500">
            joined <%= @buyer.created_at.strftime("%d %b %Y") %>
            <% if @buyer.respond_to?(:status) %> · <%= @buyer.status %><% end %>
          </p>
          <%= link_to "Open user", admin_user_path(@buyer), class: "text-xs font-medium text-indigo-600 hover:text-indigo-800" %>
        <% else %>
          <p class="text-xs text-gray-500">No account on this platform (guest or imported buyer id).</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Payment</h2>
      </div>
      <div class="px-5 py-4 space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">Payment id</span><span class="font-mono text-gray-900 text-xs"><%= @order.payment_id %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Protected</span><span class="font-mono text-gray-900 text-xs"><%= @order.protected_payment_id.presence || "—" %></span></div>
        <div class="flex justify-between"><span class="text-gray-500">Protection</span><span><%= protection_badge(@order.protection_status) %></span></div>
        <% if @order.protected_payment_id.present? && can_manage %>
          <%= form_with url: payment_admin_order_path(@order), method: :post do %>
            <button type="submit" class="mt-2 w-full px-3 py-2 text-sm font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg">
              Sync from Tween Pay
            </button>
          <% end %>
        <% end %>
        <% if @protected_payment %>
          <% payload = @protected_payment["payload"].is_a?(Hash) ? @protected_payment["payload"] : {} %>
          <div class="mt-3 rounded-lg bg-gray-50 border border-gray-200 p-3">
            <p class="text-xs text-gray-500 mb-2">Snapshot · <%= @protected_payment["synced_at"].to_s.first(16) %></p>
            <dl class="space-y-1">
              <% %w[status amount_cents commission_cents seller_proceeds_cents release_at funded_at].each do |key| %>
                <% value = payload[key] || payload.dig("protected_payment", key) %>
                <% next if value.nil? %>
                <div class="flex justify-between gap-3 text-xs">
                  <dt class="text-gray-500"><%= key.humanize %></dt>
                  <dd class="text-gray-900 font-mono truncate"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Merchant &amp; stores</h2>
      </div>
      <div class="px-5 py-4 space-y-2 text-sm">
        <div class="flex items-center justify-between gap-2">
          <span class="text-gray-900"><%= @merchant.display_name %></span>
          <% if @merchant.system_owned? %>
            <span class="text-xs font-medium text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-full">system merchant</span>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 font-mono"><%= @merchant.merchant_id %></p>
        <p class="text-xs text-gray-500">
          owner: <span class="font-mono"><%= @merchant.owner_user_id.presence || "none (platform owned)" %></span>
        </p>
        <% @storefronts.each do |storefront| %>
          <div class="flex items-center gap-2 pt-1">
            <%= store_mark(storefront, size: "w-6 h-6") %>
            <%= link_to storefront.display_name, admin_storefront_path(storefront), class: "text-xs text-indigo-600 hover:text-indigo-800 truncate" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if [ @order.shipping_address_line1, @order.shipping_city, @order.shipping_state ].any?(&:present?) %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Shipping</h2>
        </div>
        <div class="px-5 py-4 text-sm text-gray-700 space-y-0.5">
          <% @order.shipping_address.each_value do |value| %>
            <% next if value.blank? %>
            <p><%= value %></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @timeline.any? %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Platform timeline</h2>
        </div>
        <div class="divide-y divide-gray-100">
          <% @timeline.each do |entry| %>
            <div class="px-5 py-3 text-xs">
              <p class="text-gray-900 font-medium"><%= entry["action"].to_s.humanize %> → <%= entry["value"] %></p>
              <p class="text-gray-500"><%= entry["at"].to_s.first(16) %> · <span class="font-mono"><%= entry["by"] %></span></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
