<% heading = @item.product_name.presence || @item.title %>
<% content_for :title, "#{heading} — Sourcing" %>
<% content_for :page_title, "Sourcing" %>

<% can_manage = current_admin_user.has_admin_permission?(:manage_fulfillment) %>
<% margin = @procurement.cost_cents.nil? ? nil : (@item.line_total_cents - (@procurement.cost_cents.to_i * @item.quantity.to_i)) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-xl font-semibold text-gray-900 truncate"><%= heading %></h1>
      <%= entity_status_badge(@procurement.status) %>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      <%= @item.quantity %> × <%= money(@item.unit_price_cents, @item.currency) %>
      · order <span class="font-mono"><%= @order.order_id %></span>
      · opened <%= time_ago_in_words(@procurement.created_at) %> ago
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "← Queue", admin_procurements_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
    <%= link_to "Order", admin_order_path(@order), class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">What to buy</h2>
        <p class="mt-0.5 text-xs text-gray-500">The platform sells this listing itself, so the purchase is ours to make.</p>
      </div>
      <div class="px-5 py-4 flex items-start gap-4">
        <% if @product %><%= product_thumb(@product) %><% end %>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium text-gray-900"><%= heading %></div>
          <% if @item.product_name.present? && @item.title.present? && @item.title != heading %>
            <div class="text-xs text-gray-500"><%= @item.title %></div>
          <% end %>
          <% if @item.variant_attributes.present? %>
            <div class="text-xs text-gray-500"><%= Array(@item.variant_attributes).join(" · ") %></div>
          <% end %>
          <div class="text-xs text-gray-400 font-mono"><%= @item.product_id %></div>
          <% if @product&.brand.present? %>
            <div class="mt-1 text-xs text-gray-500">Brand <span class="text-gray-900"><%= @product.brand %></span></div>
          <% end %>
        </div>
      </div>
      <div class="px-5 py-4 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Supplier</p>
          <p class="mt-0.5 text-gray-900"><%= @procurement.supplier.presence || "not published by the source" %></p>
          <p class="text-xs text-gray-500"><%= @procurement.marketplace.presence || "unknown marketplace" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Buy at</p>
          <% if @procurement.buy_from.present? %>
            <%= link_to "Open the listing at source", @procurement.buy_from, target: "_blank", rel: "noopener",
                class: "mt-0.5 text-sm text-indigo-600 hover:text-indigo-800 break-all" %>
          <% else %>
            <p class="mt-0.5 text-gray-500">no source link recorded</p>
          <% end %>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Buyer paid</p>
          <p class="mt-0.5 text-gray-900"><%= money(@item.line_total_cents, @item.currency) %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">What it cost us</p>
          <p class="mt-0.5 <%= margin&.negative? ? 'text-red-600 font-medium' : 'text-gray-900' %>">
            <%= money(@procurement.cost_cents, @procurement.currency || @item.currency) %>
          </p>
          <% unless margin.nil? %>
            <p class="text-xs <%= margin.negative? ? 'text-red-600 font-medium' : 'text-emerald-700' %>">margin <%= money(margin, @item.currency) %></p>
          <% end %>
        </div>
      </div>
    </div>

    <% if can_manage %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Record and move it on</h2>
          <p class="mt-0.5 text-xs text-gray-500">Every step carries the order's fulfilment with it, so the buyer sees progress.</p>
        </div>
        <%= form_with url: advance_admin_procurement_path(@procurement), method: :post, class: "px-5 py-4 space-y-4" do %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Cost to us (kobo)</label>
              <input type="number" name="commerce_procurement[cost_cents]" value="<%= @procurement.cost_cents %>" min="0"
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Source order number</label>
              <input type="text" name="commerce_procurement[external_order_ref]" value="<%= @procurement.external_order_ref %>"
                placeholder="the order we placed at the source"
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Courier</label>
              <input type="text" name="commerce_procurement[courier]" value="<%= @procurement.courier %>"
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Tracking number</label>
              <input type="text" name="commerce_procurement[tracking_number]" value="<%= @procurement.tracking_number %>"
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Notes</label>
            <textarea name="commerce_procurement[notes]" rows="2"
              class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"><%= @procurement.notes %></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-1">
            <% @procurement.next_statuses.each do |status| %>
              <button type="submit" name="status" value="<%= status %>"
                class="px-3 py-2 text-sm font-medium rounded-lg <%= status.in?(%w[cancelled failed]) ? 'text-red-700 bg-red-50 hover:bg-red-100' : 'text-white bg-indigo-600 hover:bg-indigo-700' %>">
                <%= { "ordered" => "Bought it", "received" => "Received it", "dispatched" => "Dispatched to buyer",
                      "delivered" => "Delivered", "cancelled" => "Cancel", "failed" => "Could not source" }.fetch(status, status.humanize) %>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Where it goes</h2>
        <p class="mt-0.5 text-xs text-gray-500">The buyer's delivery details, as they gave them at checkout.</p>
      </div>
      <div class="px-5 py-4 text-sm space-y-1">
        <p class="text-gray-900"><%= @order.shipping_phone.presence || "no phone recorded" %></p>
        <p class="text-gray-700"><%= [ @order.shipping_address_line1, @order.shipping_address_line2 ].compact_blank.join(", ") %></p>
        <p class="text-gray-700"><%= [ @order.shipping_city, @order.shipping_state, @order.shipping_postal_code ].compact_blank.join(", ") %></p>
        <p class="text-gray-700"><%= @order.shipping_country %></p>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Sourcing trail</h2>
      </div>
      <div class="px-5 py-4 space-y-3 text-sm">
        <% { "Opened" => @procurement.created_at, "Bought" => @procurement.ordered_at,
             "Received" => @procurement.received_at, "Dispatched" => @procurement.dispatched_at,
             "Delivered" => @procurement.delivered_at }.each do |label, at| %>
          <div class="flex items-center justify-between gap-2">
            <span class="<%= at ? 'text-gray-900' : 'text-gray-400' %>"><%= label %></span>
            <span class="text-xs <%= at ? 'text-gray-600' : 'text-gray-400' %>">
              <%= at ? at.strftime("%d %b, %H:%M") : "—" %>
            </span>
          </div>
        <% end %>
        <% if @procurement.started_by_user_id.present? %>
          <p class="pt-2 text-xs text-gray-500">Worked by <span class="font-mono"><%= @procurement.started_by_user_id %></span></p>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Buyer</h2>
      </div>
      <div class="px-5 py-4 text-sm space-y-1">
        <p class="text-xs text-gray-500 font-mono break-all"><%= @order.buyer_user_id %></p>
        <%= link_to "Their other orders", admin_orders_path(query: @order.buyer_user_id),
            class: "text-xs font-medium text-indigo-600 hover:text-indigo-800" %>
      </div>
    </div>
  </div>
</div>
