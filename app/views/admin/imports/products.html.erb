<% content_for :title, "Imported listings — Tween Admin" %>
<% content_for :page_title, "Imports" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="admin-title text-xl font-semibold text-gray-900">Imported listings</h1>
    <p class="mt-1 text-sm text-gray-500">
      Products mirrored from the marketplaces —
      <%= number_with_delimiter(@imported_count) %> imported.
    </p>
  </div>
  <%= link_to "← Import overview", admin_imports_path,
      class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
</div>

<%= form_with url: admin_import_products_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3" do %>
  <div>
    <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Search</label>
    <input type="text" name="query" value="<%= params[:query] %>" placeholder="Title or source id"
      class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent w-64 placeholder-gray-400">
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Platform</label>
    <select name="platform" class="admin-select px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <option value="">All</option>
      <% @platforms.each do |platform| %>
        <option value="<%= platform %>" <%= "selected" if params[:platform] == platform %>><%= platform %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Status</label>
    <select name="status" class="admin-select px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <option value="">All</option>
      <% product_status_options.each do |status| %>
        <option value="<%= status %>" <%= "selected" if params[:status] == status %>><%= status %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Tween category</label>
    <select name="category" class="admin-select px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <option value="">All</option>
      <option value="none" <%= "selected" if params[:category] == "none" %>>
        Uncategorised (<%= number_with_delimiter(@uncategorised_count) %>)
      </option>
      <% @categories.each do |category| %>
        <option value="<%= category.id %>" <%= "selected" if params[:category] == category.id.to_s %>><%= category.name %></option>
      <% end %>
    </select>
  </div>
  <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors">Filter</button>
  <% if params[:query].present? || params[:platform].present? || params[:status].present? || params[:category].present? %>
    <%= link_to "Clear", admin_import_products_path, class: "px-3 py-2 text-sm text-gray-600 hover:text-gray-900" %>
  <% end %>
<% end %>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden admin-panel">
  <% if @products.records.any? %>
    <div class="overflow-x-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Listing</th>
            <th scope="col">Source</th>
            <th scope="col">Store</th>
            <th scope="col">Category</th>
            <th scope="col">Price</th>
            <th scope="col">SKUs</th>
            <th scope="col">Status</th>
            <th scope="col">Last sync</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% @products.records.each do |product| %>
            <tr class="hover:bg-gray-50">
              <td>
                <div class="text-sm font-medium text-gray-900"><%= truncate(product.title, length: 64) %></div>
                <div class="text-xs text-gray-500 font-mono"><%= product.source_id %></div>
              </td>
              <td><%= platform_badge(product.source_platform) %></td>
              <td>
                <% if product.commerce_storefront %>
                  <%= link_to truncate(product.commerce_storefront.display_name, length: 28),
                      admin_import_storefront_path(product.commerce_storefront),
                      class: "text-indigo-600 hover:text-indigo-900" %>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td>
                <% if product.commerce_category %>
                  <div class="text-gray-900"><%= truncate(product.commerce_category.name, length: 26) %></div>
                  <div class="text-xs text-gray-500 font-mono"><%= product.commerce_category.slug %></div>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">Uncategorised</span>
                <% end %>
              </td>
              <td><%= import_price(product) %></td>
              <td><%= product.commerce_skus.size %></td>
              <td>
                <% status_classes = case product.status
                   when "active" then "bg-green-100 text-green-700"
                   when "draft" then "bg-slate-100 text-slate-700"
                   else "bg-gray-100 text-gray-600"
                   end %>
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_classes %>"><%= product.status %></span>
              </td>
              <td><%= sync_label(product.source_synced_at) %></td>
              <td>
                <%= admin_detail_link "Manage", admin_import_product_path(product), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "admin/shared/pagination", collection: @products %>
  <% else %>
    <div class="p-12 text-center">
      <p class="text-sm text-gray-500">No imported listings match this filter.</p>
    </div>
  <% end %>
</div>
