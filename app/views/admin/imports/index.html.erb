<% content_for :title, "Imports — TMCP Admin" %>
<% content_for :page_title, "Imports" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-xl font-semibold text-gray-900">External catalog imports</h1>
    <p class="mt-1 text-sm text-gray-500">
      Catalogs mirrored from Jumia and Konga by the scraper. Last sync:
      <span class="font-medium text-gray-700"><%= sync_label(@stats[:last_synced_at]) %></span>
    </p>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "Source stores", admin_import_storefronts_path,
        class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50" %>
    <%= link_to "Imported listings", admin_import_products_path,
        class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50" %>
  </div>
</div>

<!-- Metric cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Source stores</p>
    <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:storefronts]) %></p>
    <div class="mt-3">
      <span class="text-xs text-gray-500">Seller and brand stores mirrored into Tween</span>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Imported listings</p>
    <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:products]) %></p>
    <div class="mt-3">
      <% if @stats[:stale_products].positive? %>
        <span class="inline-flex items-center text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">
          <%= number_with_delimiter(@stats[:stale_products]) %> stale (> 7 days)
        </span>
      <% else %>
        <span class="inline-flex items-center text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
          all synced within 7 days
        </span>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Imported reviews</p>
    <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:reviews]) %></p>
    <div class="mt-3">
      <span class="text-xs text-gray-500"><%= number_with_delimiter(@stats[:anonymous_reviews]) %> anonymised by the source</span>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Outreach needed</p>
    <p class="mt-2 text-3xl font-semibold text-gray-900 tracking-tight"><%= number_with_delimiter(@stats[:stores_without_contact]) %></p>
    <div class="mt-3">
      <span class="text-xs text-gray-500">Stores with no contact details on file</span>
    </div>
  </div>
</div>

<!-- Merchant that owns everything imported -->
<div class="bg-white rounded-xl border border-gray-200 p-5 mb-8">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-semibold text-gray-900">Platform merchant</h2>
        <% if @system_merchant %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700">system-owned</span>
        <% end %>
      </div>
      <% if @system_merchant %>
        <p class="mt-1 text-sm text-gray-500">
          Imported stores and listings belong to
          <span class="font-medium text-gray-700"><%= @system_merchant.display_name %></span>
          (<code class="px-1 py-0.5 bg-gray-100 rounded text-xs"><%= @system_merchant.merchant_id %></code>),
          not to a human merchant account.
        </p>
        <p class="mt-2 text-xs text-gray-500">
          <%= number_with_delimiter(@system_merchant.commerce_storefronts.count) %> stores ·
          <%= number_with_delimiter(@system_merchant.commerce_products.count) %> listings ·
          merchant wallet <code class="px-1 py-0.5 bg-gray-100 rounded"><%= @system_merchant.wallet_id %></code>
        </p>
      <% else %>
        <p class="mt-1 text-sm text-gray-500">
          Not created yet. Imported catalogs need a platform-owned merchant to hang off.
        </p>
      <% end %>
    </div>
    <% if @system_merchant.nil? %>
      <%= button_to "Create platform merchant", admin_import_system_merchant_path,
          class: "px-3 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700" %>
    <% end %>
  </div>
</div>

<!-- Per-platform breakdown -->
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden mb-8">
  <div class="px-5 py-4 border-b border-gray-100">
    <h2 class="text-sm font-semibold text-gray-900">By source platform</h2>
    <p class="text-xs text-gray-500 mt-0.5">What each marketplace contributed</p>
  </div>
  <% if @platforms.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-50 text-xs font-medium text-gray-500 uppercase">
          <tr>
            <th class="px-5 py-3">Platform</th>
            <th class="px-5 py-3">Source stores</th>
            <th class="px-5 py-3">Listings</th>
            <th class="px-5 py-3">Reviews</th>
            <th class="px-5 py-3">Last sync</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @platforms.each do |row| %>
            <tr class="hover:bg-gray-50/50">
              <td class="px-5 py-3"><%= platform_badge(row[:platform]) %></td>
              <td class="px-5 py-3 text-gray-900"><%= number_with_delimiter(row[:storefronts]) %></td>
              <td class="px-5 py-3 text-gray-900"><%= number_with_delimiter(row[:products]) %></td>
              <td class="px-5 py-3 text-gray-900"><%= number_with_delimiter(row[:reviews]) %></td>
              <td class="px-5 py-3 text-gray-500"><%= sync_label(row[:last_synced_at]) %></td>
              <td class="px-5 py-3 text-right">
                <%= link_to "Stores", admin_import_storefronts_path(platform: row[:platform]), class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-10 text-center">
      <p class="text-sm text-gray-500">Nothing imported yet.</p>
      <p class="mt-1 text-xs text-gray-400">
        Run a scrape with <code class="px-1 py-0.5 bg-gray-100 rounded">SCRAPER_STOREFRONT_API_URL</code> set and the catalogs will appear here.
      </p>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Recently imported listings -->
  <div class="bg-white rounded-xl border border-gray-200">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <div>
        <h2 class="text-sm font-semibold text-gray-900">Recently imported</h2>
        <p class="text-xs text-gray-500 mt-0.5">Latest listings to land</p>
      </div>
      <%= link_to admin_import_products_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1" do %>
        View all <%= fluent_icon "chevron_right", class: "w-3 h-3" %>
      <% end %>
    </div>
    <% if @recent_products.any? %>
      <div class="divide-y divide-gray-100">
        <% @recent_products.each do |product| %>
          <div class="px-5 py-3 hover:bg-gray-50/50">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <%= link_to truncate(product.title, length: 58), admin_import_product_path(product),
                    class: "text-sm font-medium text-gray-900 hover:text-indigo-700" %>
                <p class="mt-0.5 text-xs text-gray-500">
                  <%= platform_badge(product.source_platform) %>
                  <span class="ml-1 font-mono"><%= product.source_id %></span>
                </p>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="text-sm text-gray-900"><%= import_price(product) %></p>
                <p class="text-xs text-gray-400"><%= sync_label(product.source_synced_at) %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center text-sm text-gray-500">No imported listings yet.</div>
    <% end %>
  </div>

  <!-- Outreach queue + stale listings -->
  <div class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Sellers to reach</h2>
          <p class="text-xs text-gray-500 mt-0.5">Imported stores with no contact details</p>
        </div>
        <%= link_to admin_import_storefronts_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1" do %>
          All stores <%= fluent_icon "chevron_right", class: "w-3 h-3" %>
        <% end %>
      </div>
      <% if @stores_without_contact.any? %>
        <div class="divide-y divide-gray-100">
          <% @stores_without_contact.each do |store| %>
            <div class="px-5 py-3 flex items-center justify-between gap-3 hover:bg-gray-50/50">
              <div class="min-w-0">
                <%= link_to store.display_name, admin_import_storefront_path(store),
                    class: "text-sm font-medium text-gray-900 hover:text-indigo-700" %>
                <p class="mt-0.5 text-xs text-gray-500">
                  <%= platform_badge(store.source_platform) %>
                  <span class="ml-1"><%= store.source_kind || "store" %></span>
                </p>
              </div>
              <%= link_to "Add contact", admin_import_storefront_path(store),
                  class: "flex-shrink-0 text-xs font-medium text-indigo-600 hover:text-indigo-800" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center text-sm text-gray-500">Every imported store has contact details on file.</div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Needs a re-sync</h2>
        <p class="text-xs text-gray-500 mt-0.5">Not refreshed in the last 7 days</p>
      </div>
      <% if @stale_products.any? %>
        <div class="divide-y divide-gray-100">
          <% @stale_products.each do |product| %>
            <div class="px-5 py-3 flex items-center justify-between gap-3 hover:bg-gray-50/50">
              <%= link_to truncate(product.title, length: 48), admin_import_product_path(product),
                  class: "text-sm text-gray-900 hover:text-indigo-700 min-w-0" %>
              <span class="flex-shrink-0 text-xs text-amber-700"><%= sync_label(product.source_synced_at) %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center text-sm text-gray-500">Everything is fresh.</div>
      <% end %>
    </div>
  </div>
</div>
