<% content_for :title, "#{truncate(@product.title, length: 50)} — Imported listing" %>
<% content_for :page_title, "Imports" %>

<% brand = @source["brand"].presence %>
<% seller = @source["seller_name"].presence %>
<% category_path = Array(@source["category_path"]).reject(&:blank?) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <div class="flex items-center gap-2">
      <h1 class="text-xl font-semibold text-gray-900"><%= @product.title %></h1>
      <%= platform_badge(@product.source_platform) %>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      <span class="font-mono"><%= @product.source_id %></span>
      <% if @product.commerce_storefront %>
        · <%= link_to @product.commerce_storefront.display_name,
            admin_import_storefront_path(@product.commerce_storefront),
            class: "text-indigo-600 hover:text-indigo-800" %>
      <% end %>
      · last synced <%= sync_label(@product.source_synced_at) %>
    </p>
  </div>
  <%= link_to "← All imported listings", admin_import_products_path,
      class: "text-sm font-medium text-indigo-600 hover:text-indigo-800 flex-shrink-0" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Left: editable listing + skus + reviews -->
  <div class="lg:col-span-2 space-y-6">
    <%= form_with model: @product, url: admin_import_product_path(@product), method: :patch,
        class: "bg-white rounded-xl border border-gray-200" do |form| %>
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Listing settings</h2>
        <p class="text-xs text-gray-500 mt-0.5">
          Control whether this mirrored listing is live on Tween.
        </p>
      </div>

      <div class="p-5 space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= form.label :status, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.select :status, product_status_options,
                {}, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div class="flex items-end">
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
              <%= form.check_box :featured, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              Featured on Tween
            </label>
          </div>
        </div>
      </div>

      <div class="px-5 py-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-gray-400 max-w-md">
          A re-import refreshes content from the source; status and featured stay under your control.
        </p>
        <%= form.submit "Save listing",
            class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors" %>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Mirrored content</h2>
        <p class="text-xs text-gray-500 mt-0.5">Read-only — refreshed by the scraper on each sync</p>
      </div>

      <dl class="px-5 py-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Price</dt>
          <dd class="mt-1 text-gray-900"><%= import_price(@product) %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Condition</dt>
          <dd class="mt-1 text-gray-900"><%= @product.condition.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Brand</dt>
          <dd class="mt-1 text-gray-900"><%= brand || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Seller</dt>
          <dd class="mt-1 text-gray-900"><%= seller || "—" %></dd>
        </div>
        <% if category_path.any? %>
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Category</dt>
            <dd class="mt-1 text-gray-900"><%= category_path.join(" › ") %></dd>
          </div>
        <% end %>
        <% if @product.tags.present? %>
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Tags</dt>
            <dd class="mt-1 flex flex-wrap gap-1.5">
              <% @product.tags.each do |tag| %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= tag %></span>
              <% end %>
            </dd>
          </div>
        <% end %>
        <% if @product.description.present? %>
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Description</dt>
            <dd class="mt-1 text-gray-700 whitespace-pre-line"><%= truncate(@product.description, length: 600) %></dd>
          </div>
        <% end %>
      </dl>

      <% media = Array(@product.media_urls) %>
      <% if media.any? %>
        <div class="px-5 pb-5">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Images (<%= media.size %>)</p>
          <div class="flex flex-wrap gap-2">
            <% media.first(8).each do |url| %>
              <%= link_to url, target: "_blank", rel: "noopener", class: "block" do %>
                <%= image_tag url, class: "w-16 h-16 object-cover rounded-lg border border-gray-200", loading: "lazy" %>
              <% end %>
            <% end %>
            <% if media.size > 8 %>
              <span class="w-16 h-16 rounded-lg border border-dashed border-gray-200 flex items-center justify-center text-xs text-gray-500">
                +<%= media.size - 8 %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Variants (SKUs)</h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= @skus.size %> mirrored from the source</p>
      </div>
      <% if @skus.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">SKU</th>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source id</th>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stock</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @skus.each do |sku| %>
                <tr>
                  <td class="px-5 py-3 text-sm text-gray-900"><%= sku.title.presence || "Default" %></td>
                  <td class="px-5 py-3 text-xs font-mono text-gray-500"><%= sku.properties&.dig("source_sku_id") || "—" %></td>
                  <td class="px-5 py-3 text-sm text-gray-900 whitespace-nowrap">
                    <%= sku_price(sku) %>
                  </td>
                  <td class="px-5 py-3 text-sm whitespace-nowrap">
                    <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= sku.inventory_status == "in_stock" ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                      <%= sku.inventory_status %>
                    </span>
                    <span class="ml-1 text-xs text-gray-500"><%= sku.quantity_available.to_i %> in stock</span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center text-sm text-gray-500">No variants mirrored yet.</div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-semibold text-gray-900">Imported reviews</h2>
            <p class="text-xs text-gray-500 mt-0.5">Buyer identity is preserved exactly as it appeared at the source</p>
          </div>
          <span class="text-xs text-gray-500"><%= @reviews.size %> shown</span>
        </div>
      </div>
      <% if @reviews.any? %>
        <div class="divide-y divide-gray-100">
          <% @reviews.each do |review| %>
            <div class="px-5 py-4">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">
                    <%= review.reviewer_display_name.presence || (review.is_anonymous ? "Anonymous Buyer" : "Tween Shopper") %>
                  </p>
                  <p class="mt-0.5 text-xs text-gray-500">
                    <span class="text-amber-500"><%= "★" * review.rating %><span class="text-gray-300"><%= "★" * (5 - review.rating) %></span></span>
                    <% if review.review_date %>
                      <span class="ml-1"><%= review.review_date.to_date.to_fs(:long) %></span>
                    <% end %>
                  </p>
                </div>
                <% status_classes = case review.status
                   when "approved" then "bg-green-100 text-green-700"
                   when "rejected" then "bg-red-100 text-red-700"
                   else "bg-amber-100 text-amber-700"
                   end %>
                <span class="flex-shrink-0 px-2 py-0.5 rounded-full text-xs font-medium <%= status_classes %>"><%= review.status %></span>
              </div>

              <% if review.title.present? %>
                <p class="mt-2 text-sm font-medium text-gray-800"><%= review.title %></p>
              <% end %>
              <% if review.body.present? %>
                <p class="mt-1 text-sm text-gray-600"><%= truncate(review.body, length: 400) %></p>
              <% end %>

              <div class="mt-3 flex flex-wrap items-center gap-2">
                <%= form_with url: admin_import_review_path(review), method: :patch, class: "flex items-center gap-2" do %>
                  <select name="commerce_review[status]"
                    class="px-2 py-1 text-xs border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <% review_status_options.each do |status| %>
                      <option value="<%= status %>" <%= "selected" if review.status == status %>><%= status %></option>
                    <% end %>
                  </select>
                  <button type="submit"
                    class="px-2.5 py-1 text-xs font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors">
                    Update
                  </button>
                <% end %>
                <span class="text-xs text-gray-400">helpful: <%= review.helpful_count.to_i %></span>
                <% if review.source_payload.is_a?(Hash) && ActiveModel::Type::Boolean.new.cast(review.source_payload["verified_purchase"]) %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">verified</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center text-sm text-gray-500">No imported reviews for this listing.</div>
      <% end %>
    </div>
  </div>

  <!-- Right: provenance -->
  <div class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Provenance</h2>
        <p class="text-xs text-gray-500 mt-0.5">Where this listing was mirrored from</p>
      </div>

      <dl class="px-5 py-4 space-y-3 text-sm">
        <div class="flex items-start justify-between gap-3">
          <dt class="text-gray-500 flex-shrink-0">Source page</dt>
          <dd class="text-right min-w-0">
            <% if @product.source_url.present? %>
              <%= link_to truncate(@product.source_url, length: 46), @product.source_url,
                  target: "_blank", rel: "noopener",
                  class: "text-indigo-600 hover:text-indigo-800 break-all" %>
            <% else %>
              <span class="text-gray-400">—</span>
            <% end %>
          </dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-gray-500">Platform</dt>
          <dd><%= platform_badge(@product.source_platform) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-gray-500">Source id</dt>
          <dd class="font-mono text-xs text-gray-700"><%= @product.source_id.presence || "—" %></dd>
        </div>
        <div class="flex items-start justify-between gap-3">
          <dt class="text-gray-500 flex-shrink-0">Merchant</dt>
          <dd class="text-right min-w-0">
            <span class="text-gray-900"><%= @product.commerce_merchant&.display_name %></span>
            <span class="block font-mono text-xs text-gray-500"><%= @product.commerce_merchant&.merchant_id %></span>
          </dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-gray-500">Scraped</dt>
          <dd class="text-gray-700"><%= sync_label(@product.source_synced_at) %></dd>
        </div>
        <% if @source["rating_average"].present? %>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-gray-500">Source rating</dt>
            <dd class="text-gray-700">
              <%= @source["rating_average"] %>
              <span class="text-xs text-gray-500">(<%= @source["rating_count"].to_i %>)</span>
            </dd>
          </div>
        <% end %>
        <% badges = Array(@source["badges"]).reject(&:blank?) %>
        <% if badges.any? %>
          <div class="flex items-start justify-between gap-3">
            <dt class="text-gray-500 flex-shrink-0">Badges</dt>
            <dd class="text-right flex flex-wrap gap-1 justify-end">
              <% badges.each do |badge| %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= badge %></span>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>

      <% if @source.present? %>
        <details class="border-t border-gray-100">
          <summary class="px-5 py-3 text-xs font-medium text-gray-500 cursor-pointer hover:text-gray-700">Raw source payload</summary>
          <pre class="px-5 py-3 text-xs text-gray-600 bg-gray-50 overflow-x-auto"><%= JSON.pretty_generate(@source) %></pre>
        </details>
      <% end %>
    </div>
  </div>
</div>
