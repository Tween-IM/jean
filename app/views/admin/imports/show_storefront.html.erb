<% content_for :title, "#{@storefront.display_name} — Imported store" %>
<% content_for :page_title, "Imports" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <div class="flex items-center gap-2">
      <h1 class="text-xl font-semibold text-gray-900 truncate"><%= @storefront.display_name %></h1>
      <%= platform_badge(@storefront.source_platform) %>
      <%= source_kind_badge(@storefront.source_kind) %>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      <span class="font-mono"><%= @storefront.slug %></span>
      · <%= number_with_delimiter(@product_count) %> listings
      · last synced <%= sync_label(@storefront.source_synced_at) %>
    </p>
  </div>
  <%= link_to "← All source stores", admin_import_storefronts_path,
      class: "text-sm font-medium text-indigo-600 hover:text-indigo-800 flex-shrink-0" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Left: editable store + listings -->
  <div class="lg:col-span-2 space-y-6">
    <%= form_with model: @storefront, url: admin_import_storefront_path(@storefront), method: :patch, class: "bg-white rounded-xl border border-gray-200" do |form| %>
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Store settings</h2>
        <p class="text-xs text-gray-500 mt-0.5">
          Correct what the scraper cannot know — branding and how to reach the seller.
        </p>
      </div>

      <div class="p-5 space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= form.label :display_name, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :display_name, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :store_type, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.select :store_type, %w[marketplace ecommerce], {},
                class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= form.label :status, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.select :status, %w[draft published suspended closed], {},
                class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :accent_color, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :accent_color, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div class="flex items-end">
            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
              <%= form.check_box :featured, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              Featured on Tween
            </label>
          </div>
        </div>

        <div>
          <%= form.label :about, "About", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
          <%= form.text_area :about, rows: 3, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          <p class="mt-1 text-xs text-gray-400">Shown on the store page. Mirrored from the marketplace on import.</p>
        </div>

        <div>
          <%= form.label :description, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
          <%= form.text_area :description, rows: 2, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="pt-2 border-t border-gray-100">
          <h3 class="text-sm font-semibold text-gray-900 mt-4">Contact details</h3>
          <p class="text-xs text-gray-500 mt-0.5 mb-3">
            Owner-only. Marketplaces rarely publish these — record what you learn when reaching out.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :contact_phone, "Phone", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_phone, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :contact_email, "Email", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_email, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :contact_website, "Website", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_website, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :contact_address, "Address", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
              <%= form.text_field :contact_address, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            </div>
          </div>
        </div>
      </div>

      <div class="px-5 py-4 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-gray-400 max-w-md">
          Re-imports refresh branding from the source; contact details are never overwritten with blanks.
        </p>
        <%= form.submit "Save store",
            class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors" %>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Listings</h2>
          <p class="text-xs text-gray-500 mt-0.5">Showing the <%= [ @products.size, @product_count ].min %> most recent</p>
        </div>
        <%= link_to admin_import_products_path(platform: @storefront.source_platform),
            class: "text-xs font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1" do %>
          All <%= @storefront.source_platform %> listings <%= fluent_icon "chevron_right", class: "w-3 h-3" %>
        <% end %>
      </div>
      <% if @products.any? %>
        <div class="divide-y divide-gray-100">
          <% @products.each do |product| %>
            <div class="px-5 py-3 flex items-center justify-between gap-3 hover:bg-gray-50/50">
              <div class="min-w-0">
                <%= link_to truncate(product.title, length: 60), admin_import_product_path(product),
                    class: "text-sm font-medium text-gray-900 hover:text-indigo-700" %>
                <p class="mt-0.5 text-xs text-gray-500 font-mono"><%= product.source_id %></p>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="text-sm text-gray-900"><%= import_price(product) %></p>
                <p class="text-xs <%= product.status == "active" ? 'text-emerald-600' : 'text-gray-400' %>"><%= product.status %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-10 text-center text-sm text-gray-500">This store has no listings yet.</div>
      <% end %>
    </div>
  </div>

  <!-- Right: provenance + imported reviews -->
  <div class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Provenance</h2>
        <p class="text-xs text-gray-500 mt-0.5">Where this store was mirrored from</p>
      </div>

      <dl class="px-5 py-4 space-y-3 text-sm">
        <div class="flex items-start justify-between gap-3">
          <dt class="text-gray-500 flex-shrink-0">Source page</dt>
          <dd class="text-right min-w-0">
            <% if @storefront.source_url.present? %>
              <%= link_to truncate(@storefront.source_url, length: 46), @storefront.source_url,
                  target: "_blank", rel: "noopener",
                  class: "text-indigo-600 hover:text-indigo-800 break-all" %>
            <% else %>
              <span class="text-gray-400">—</span>
            <% end %>
          </dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-gray-500">Platform</dt>
          <dd><%= platform_badge(@storefront.source_platform) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-gray-500">Kind</dt>
          <dd><%= source_kind_badge(@storefront.source_kind) %></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-gray-500">Source id</dt>
          <dd class="font-mono text-xs text-gray-700"><%= @storefront.source_id.presence || "—" %></dd>
        </div>
        <div class="flex items-center justify-between gap-3">
          <dt class="text-gray-500">Last synced</dt>
          <dd class="text-gray-700"><%= sync_label(@storefront.source_synced_at) %></dd>
        </div>
        <div class="flex items-start justify-between gap-3">
          <dt class="text-gray-500 flex-shrink-0">Merchant</dt>
          <dd class="text-right min-w-0">
            <span class="text-gray-900"><%= @storefront.commerce_merchant&.display_name %></span>
            <span class="block font-mono text-xs text-gray-500"><%= @storefront.commerce_merchant&.merchant_id %></span>
          </dd>
        </div>
        <% if @storefront.social_links.present? %>
          <div class="flex items-start justify-between gap-3">
            <dt class="text-gray-500 flex-shrink-0">Socials</dt>
            <dd class="text-right space-y-1 min-w-0">
              <% @storefront.social_links.each do |network, url| %>
                <%= link_to network.to_s.titleize, url.to_s,
                    target: "_blank", rel: "noopener",
                    class: "block text-xs text-indigo-600 hover:text-indigo-800 break-all" %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>

      <% payload = @storefront.source_payload.is_a?(Hash) ? @storefront.source_payload : {} %>
      <% if payload.present? %>
        <details class="border-t border-gray-100">
          <summary class="px-5 py-3 text-xs font-medium text-gray-500 cursor-pointer hover:text-gray-700">Raw source payload</summary>
          <pre class="px-5 py-3 text-xs text-gray-600 bg-gray-50 overflow-x-auto"><%= JSON.pretty_generate(payload) %></pre>
        </details>
      <% end %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Imported reviews</h2>
          <p class="text-xs text-gray-500 mt-0.5">
            <%= number_with_delimiter(@reviews_count) %> mirrored, buyer identity preserved
          </p>
        </div>
      </div>

      <% if @reviews.any? %>
        <div class="divide-y divide-gray-100">
          <% @reviews.each do |review| %>
            <div class="px-5 py-4">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">
                    <%= review.reviewer_display_name.presence || "Anonymous Buyer" %>
                  </p>
                  <p class="mt-0.5 text-xs text-gray-500">
                    <span class="text-amber-500"><%= "★" * review.rating %></span>
                    <span class="ml-1"><%= review.status %></span>
                  </p>
                </div>
                <% if review.is_anonymous %>
                  <span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
                    anonymous
                  </span>
                <% end %>
              </div>

              <% if review.body.present? %>
                <p class="mt-2 text-xs text-gray-600"><%= truncate(review.body, length: 140) %></p>
              <% end %>

              <%= form_with url: admin_import_review_path(review), method: :patch,
                  class: "mt-3 flex flex-wrap items-center gap-2" do %>
                <select name="commerce_review[status]"
                  class="px-2 py-1 text-xs border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                  <% review_status_options.each do |status| %>
                    <option value="<%= status %>" <%= "selected" if review.status == status %>><%= status %></option>
                  <% end %>
                </select>
                <button type="submit"
                  class="px-2.5 py-1 text-xs font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors">
                  Update
                </button>
                <% if review.commerce_product %>
                  <%= link_to "View listing", admin_import_product_path(review.commerce_product),
                      class: "text-xs text-gray-500 hover:text-indigo-700" %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center text-sm text-gray-500">No imported reviews yet.</div>
      <% end %>
    </div>
  </div>
</div>
