<% content_for :title, "#{@merchant.display_name} — Merchant" %>
<% content_for :page_title, "Merchants" %>

<% can_manage = current_admin_user.has_admin_permission?(:manage_merchants) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-xl font-semibold text-gray-900 truncate"><%= @merchant.display_name %></h1>
      <%= entity_status_badge(@merchant.status) %>
      <% if @merchant.system_owned? %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">system merchant</span>
      <% end %>
      <% if @merchant.verified? %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">verified</span>
      <% end %>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      <span class="font-mono"><%= @merchant.merchant_id %></span>
      · <%= number_with_delimiter(@storefronts.size) %> stores
      · <%= number_with_delimiter(@products_count) %> listings
      · <%= number_with_delimiter(@order_count) %> orders
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "← All merchants", admin_merchants_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
    <%= link_to "Their orders", admin_orders_path(merchant: @merchant.merchant_id), class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <%= form_with model: @merchant, url: admin_merchant_path(@merchant), method: :patch, class: "bg-white rounded-xl border border-gray-200" do |form| %>
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Merchant profile</h2>
        <p class="text-xs text-gray-500 mt-0.5">Commercial terms and how the platform reaches them</p>
      </div>
      <div class="p-5 space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= form.label :display_name, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :display_name, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :business_type, "Business type", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.select :business_type, %w[individual registered_business ngo].map { |type| [ type.humanize, type ] }, {},
                class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :commission_rate, "Commission (basis points)", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.number_field :commission_rate, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
            <p class="mt-1 text-xs text-gray-400">500 = 5.00%</p>
          </div>
          <div>
            <%= form.label :status, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.select :status, %w[pending_review active suspended closed].map { |status| [ status.humanize, status ] }, {},
                class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :email, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :email, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :phone, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :phone, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :website, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :website, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :registration_number, "RC number", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :registration_number, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= form.label :address_line1, "Address", class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :address_line1, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :city, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :city, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :state, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
            <%= form.text_field :state, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>
        <div>
          <%= form.label :about, class: "block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1" %>
          <%= form.text_area :about, rows: 3, class: "w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>
      <% if can_manage %>
        <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">
          <p class="text-xs text-gray-400">Changes here are audit logged against your admin account.</p>
          <%= form.submit "Save merchant", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg" %>
        </div>
      <% end %>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Stores</h2>
        <p class="text-xs text-gray-500 mt-0.5"><%= number_with_delimiter(@storefronts.size) %> storefront(s)</p>
      </div>
      <% if @storefronts.any? %>
        <table class="min-w-full divide-y divide-gray-100">
          <tbody class="divide-y divide-gray-100">
            <% @storefronts.each do |storefront| %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <%= store_mark(storefront) %>
                    <div class="min-w-0">
                      <div class="text-sm font-medium text-gray-900 truncate"><%= storefront.display_name %></div>
                      <div class="text-xs text-gray-500">
                        <%= number_with_delimiter(storefront.product_count) %> listings
                        <% if storefront.source_platform.present? %> · <%= storefront.source_platform %><% end %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3"><%= entity_status_badge(storefront.status) %></td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "Manage", admin_storefront_path(storefront), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-5 py-6 text-sm text-gray-500">No stores yet.</div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Recent orders</h2>
      </div>
      <% if @orders.any? %>
        <table class="min-w-full divide-y divide-gray-100">
          <tbody class="divide-y divide-gray-100">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-3 text-sm font-mono text-gray-900"><%= order.order_id %></td>
                <td class="px-5 py-3 text-sm text-gray-600 truncate max-w-[12rem]"><%= order.buyer_user_id %></td>
                <td class="px-5 py-3 text-sm text-gray-900"><%= money(order.total_cents, order.currency) %></td>
                <td class="px-5 py-3"><%= order_status_badge(order.status) %></td>
                <td class="px-5 py-3 text-right">
                  <%= link_to "Manage", admin_order_path(order), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-5 py-6 text-sm text-gray-500">No orders yet.</div>
      <% end %>
    </div>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Value on platform</p>
      <p class="mt-1 text-2xl font-semibold text-gray-900"><%= money(@gmv_cents, "NGN") %></p>
      <p class="mt-0.5 text-xs text-gray-500">paid and fulfilled orders</p>
      <div class="mt-4 pt-4 border-t border-gray-100 grid grid-cols-2 gap-3">
        <div>
          <p class="text-xs text-gray-500">Orders</p>
          <p class="text-lg font-semibold text-gray-900"><%= number_with_delimiter(@order_count) %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500">Open</p>
          <p class="text-lg font-semibold <%= @open_orders.positive? ? 'text-amber-600' : 'text-gray-900' %>"><%= number_with_delimiter(@open_orders) %></p>
        </div>
      </div>
    </div>

    <% if can_manage %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Account actions</h2>
        </div>
        <div class="p-5 space-y-3">
          <% unless @merchant.verified? %>
            <%= button_to "Verify merchant", verify_admin_merchant_path(@merchant),
                class: "w-full px-3 py-2 text-sm font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg",
                form: { data: { turbo: false } } %>
          <% end %>
          <% if @merchant.status == "suspended" %>
            <%= button_to "Reactivate", reactivate_admin_merchant_path(@merchant),
                class: "w-full px-3 py-2 text-sm font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg",
                form: { data: { turbo: false } } %>
          <% else %>
            <%= button_to "Suspend merchant", suspend_admin_merchant_path(@merchant),
                class: "w-full px-3 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 rounded-lg",
                form: { data: { turbo: false } },
                data: { confirm: "Suspend #{@merchant.display_name}?" } %>
          <% end %>
          <% if @merchant.system_owned? %>
            <p class="text-xs text-gray-400">
              The system merchant is the platform itself: suspending it would stop the mirrored catalogues
              from selling.
            </p>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Owner</h2>
      </div>
      <div class="px-5 py-4 text-sm space-y-1">
        <% if @owner %>
          <p class="text-gray-900"><%= @owner.matrix_username.presence || @owner.matrix_user_id %></p>
          <p class="text-xs text-gray-500 font-mono"><%= @owner.matrix_user_id %></p>
          <%= link_to "Open user", admin_user_path(@owner), class: "text-xs font-medium text-indigo-600 hover:text-indigo-800" %>
        <% else %>
          <p class="text-gray-600">
            <%= @merchant.owner_user_id.present? ? @merchant.owner_user_id : "No human owner — the platform runs this merchant." %>
          </p>
        <% end %>
        <p class="text-xs text-gray-500 pt-2">Wallet <span class="font-mono"><%= @merchant.wallet_id %></span></p>
      </div>
    </div>

    <% if @payouts.any? %>
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Recent payouts</h2>
        </div>
        <div class="divide-y divide-gray-100">
          <% @payouts.each do |payout| %>
            <div class="px-5 py-3 text-sm">
              <div class="flex items-center justify-between">
                <span class="font-medium text-gray-900"><%= money(payout.amount_cents, payout.currency) %></span>
                <%= entity_status_badge(payout.status) %>
              </div>
              <p class="text-xs text-gray-500 mt-0.5"><%= payout.payout_method.humanize %> · <%= payout.created_at.strftime("%d %b %Y") %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
