<% content_for :title, "Merchants — TMCP Admin" %>
<% content_for :page_title, "Merchants" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-xl font-semibold text-gray-900">Merchants</h1>
    <p class="mt-1 text-sm text-gray-500">
      Who sells on Tween. The system merchant owns every mirrored catalogue and
      has no human owner — its orders are worked from the Orders screen.
    </p>
  </div>
  <%= link_to "Orders →", admin_orders_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
</div>

<div class="grid grid-cols-2 lg:grid-cols-6 gap-3 mb-5">
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Merchants</p>
    <p class="mt-1 text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@stats[:total]) %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Active</p>
    <p class="mt-1 text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@stats[:active]) %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Pending review</p>
    <p class="mt-1 text-2xl font-semibold <%= @stats[:pending].positive? ? 'text-amber-600' : 'text-gray-900' %>"><%= number_with_delimiter(@stats[:pending]) %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Suspended</p>
    <p class="mt-1 text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@stats[:suspended]) %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Verified</p>
    <p class="mt-1 text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@stats[:verified]) %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">System</p>
    <p class="mt-1 text-2xl font-semibold text-indigo-600"><%= number_with_delimiter(@stats[:system]) %></p>
  </div>
</div>

<%= form_with url: admin_merchants_path, method: :get, class: "mb-4 bg-white rounded-xl border border-gray-200 p-4" do %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Search</label>
      <input type="text" name="query" value="<%= params[:query] %>" placeholder="Name, id or owner"
        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-gray-400">
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Status</label>
      <select name="status" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">All</option>
        <% @statuses.each do |status| %>
          <option value="<%= status %>" <%= "selected" if params[:status] == status %>><%= status.humanize %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Ownership</label>
      <select name="ownership" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">All</option>
        <option value="system" <%= "selected" if params[:ownership] == "system" %>>System owned</option>
        <option value="merchant" <%= "selected" if params[:ownership] == "merchant" %>>Merchant owned</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Sort</label>
      <div class="flex gap-2">
        <select name="sort" class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="name" <%= "selected" if params[:sort].blank? || params[:sort] == "name" %>>Name</option>
          <option value="orders" <%= "selected" if params[:sort] == "orders" %>>Most orders</option>
          <option value="gmv" <%= "selected" if params[:sort] == "gmv" %>>Highest value</option>
        </select>
        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg">Filter</button>
      </div>
    </div>
  </div>
<% end %>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <% if @merchants.records.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Merchant</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Stores</th>
          <th class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Listings</th>
          <th class="px-5 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Commission</th>
          <th class="px-5 py-3"></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% @merchants.records.each do |merchant| %>
          <tr class="hover:bg-gray-50">
            <td class="px-5 py-3">
              <div class="text-sm font-medium text-gray-900"><%= merchant.display_name %></div>
              <div class="text-xs text-gray-500 font-mono"><%= merchant.merchant_id %></div>
            </td>
            <td class="px-5 py-3 text-sm text-gray-700 truncate max-w-[14rem]">
              <%= merchant.owner_user_id.presence || tag.span("platform owned", class: "text-indigo-600 text-xs font-medium") %>
            </td>
            <td class="px-5 py-3">
              <%= entity_status_badge(merchant.status) %>
              <% if merchant.verified? %>
                <div class="mt-1 text-xs text-emerald-600 font-medium">verified</div>
              <% end %>
            </td>
            <td class="px-5 py-3 text-right text-sm text-gray-900"><%= number_with_delimiter(@store_counts[merchant.id].to_i) %></td>
            <td class="px-5 py-3 text-right text-sm text-gray-900"><%= number_with_delimiter(@product_counts[merchant.id].to_i) %></td>
            <td class="px-5 py-3 text-right text-sm text-gray-700"><%= (merchant.commission_rate.to_i / 100.0).round(2) %>%</td>
            <td class="px-5 py-3 text-right">
              <%= link_to "Manage", admin_merchant_path(merchant), class: "text-sm font-medium text-indigo-600 hover:text-indigo-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/shared/pagination", collection: @merchants %>
  <% else %>
    <div class="p-12 text-center">
      <p class="text-sm text-gray-500">No merchants match this filter.</p>
    </div>
  <% end %>
</div>
