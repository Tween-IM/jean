<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; padding: 0; background-color: #f4f4f7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .container { max-width: 560px; margin: 0 auto; background: #ffffff; }
    .header { background-color: #6C3CE1; padding: 28px 24px; text-align: center; }
    .header h1 { color: #ffffff; font-size: 20px; margin: 0; font-weight: 600; }
    .content { padding: 32px 24px; }
    .content h2 { font-size: 18px; color: #1a1a2e; margin: 0 0 12px; }
    .content p { font-size: 15px; color: #4a4a68; line-height: 1.6; margin: 0 0 20px; }
    .cta { display: inline-block; background-color: #6C3CE1; color: #ffffff; text-decoration: none; padding: 12px 28px; border-radius: 6px; font-weight: 500; font-size: 15px; }
    .footer { padding: 24px; text-align: center; font-size: 12px; color: #999999; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Tween</h1>
    </div>
    <div class="content">
      <h2><%= @title %></h2>
      <p><%= @body %></p>
      <% if @deep_link.present? %>
        <p><a href="<%= @deep_link %>" class="cta">View Details</a></p>
      <% end %>
    </div>
    <div class="footer">
      This email was sent by Tween. If you didn't expect this, please ignore.
    </div>
  </div>
</body>
</html>
